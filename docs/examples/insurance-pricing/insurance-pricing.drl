package com.insurance.auto

// ============================================================================
// AUTO INSURANCE PRICING RULES
// A comprehensive underwriting system for risk assessment and premium calculation.
// ============================================================================

// --- Type Declarations ---

declare InsuranceApplication
    applicationId: String
    applicantName: String
    age: int
    licenseYears: int
    accidentCount: int
    violationCount: int
    dui: boolean
    vehicleYear: int
    vehicleMake: String
    vehicleModel: String
    vehicleType: String
    antiTheft: boolean
    airbags: boolean
    absSystem: boolean
    zipCode: String
    annualMileage: int
    garageParked: boolean
    multiPolicy: boolean
    existingCustomer: boolean
end

declare DriverRiskProfile
    applicationId: String
    ageCategory: String
    experienceLevel: String
    drivingRecord: String
    riskScore: int
end

declare VehicleRiskProfile
    applicationId: String
    vehicleCategory: String
    safetyRating: String
    vehicleAge: int
end

declare PremiumCalculation
    applicationId: String
    basePremium: double
    driverMultiplier: double
    vehicleMultiplier: double
    locationMultiplier: double
    discountPercent: double
    finalPremium: double
end

declare PolicyDecision
    applicationId: String
    approved: boolean
    annualPremium: double
    monthlyPayment: double
    coverageLevel: String
    reason: String
end

declare DeclineReason
    applicationId: String
    reason: String
    code: String
end

// ============================================================================
// PHASE 1: DRIVER RISK PROFILING (salience 100)
// ============================================================================

rule "Driver Profile - Young Driver High Risk"
    salience 100
    when
        $app: InsuranceApplication(age < 25, $id: applicationId)
        not DriverRiskProfile(applicationId == $id)
    then
        var expLevel = app.licenseYears >= 3 ? "Moderate" : "New";
        var record = "Clean";
        var riskScore = 60;

        if (app.dui) {
            record = "Uninsurable";
            riskScore = 100;
        } else if (app.accidentCount >= 2 || app.violationCount >= 4) {
            record = "Major Issues";
            riskScore = 85;
        } else if (app.accidentCount >= 1 || app.violationCount >= 2) {
            record = "Minor Issues";
            riskScore = 70;
        }

        console.log("Driver Profile: " + app.applicantName + " - Young (" + app.age + "), " + record);

        drools.insert({
            type: "com.insurance.auto.DriverRiskProfile",
            applicationId: app.applicationId,
            ageCategory: "Young",
            experienceLevel: expLevel,
            drivingRecord: record,
            riskScore: riskScore
        });
end

rule "Driver Profile - Adult Standard Risk"
    salience 100
    when
        $app: InsuranceApplication(age >= 25, age <= 65, $id: applicationId)
        not DriverRiskProfile(applicationId == $id)
    then
        var expLevel = "Experienced";
        if (app.licenseYears < 2) {
            expLevel = "New";
        } else if (app.licenseYears < 5) {
            expLevel = "Moderate";
        }

        var record = "Clean";
        var riskScore = 30;

        if (app.dui) {
            record = "Uninsurable";
            riskScore = 100;
        } else if (app.accidentCount >= 2 || app.violationCount >= 4) {
            record = "Major Issues";
            riskScore = 70;
        } else if (app.accidentCount >= 1 || app.violationCount >= 1) {
            record = "Minor Issues";
            riskScore = 45;
        }

        console.log("Driver Profile: " + app.applicantName + " - Adult (" + app.age + "), " + record);

        drools.insert({
            type: "com.insurance.auto.DriverRiskProfile",
            applicationId: app.applicationId,
            ageCategory: "Adult",
            experienceLevel: expLevel,
            drivingRecord: record,
            riskScore: riskScore
        });
end

rule "Driver Profile - Senior Driver"
    salience 100
    when
        $app: InsuranceApplication(age > 65, $id: applicationId)
        not DriverRiskProfile(applicationId == $id)
    then
        var expLevel = "Experienced";
        var record = "Clean";
        var riskScore = 45;

        if (app.dui) {
            record = "Uninsurable";
            riskScore = 100;
        } else if (app.accidentCount >= 2) {
            record = "Major Issues";
            riskScore = 80;
        } else if (app.accidentCount >= 1 || app.violationCount >= 2) {
            record = "Minor Issues";
            riskScore = 60;
        }

        // Additional risk for very elderly drivers
        if (app.age > 80) {
            riskScore = riskScore + 15;
        }

        console.log("Driver Profile: " + app.applicantName + " - Senior (" + app.age + "), " + record);

        drools.insert({
            type: "com.insurance.auto.DriverRiskProfile",
            applicationId: app.applicationId,
            ageCategory: "Senior",
            experienceLevel: expLevel,
            drivingRecord: record,
            riskScore: riskScore
        });
end

// ============================================================================
// PHASE 2: VEHICLE RISK PROFILING (salience 90)
// ============================================================================

rule "Vehicle Profile Assessment"
    salience 90
    when
        $app: InsuranceApplication($id: applicationId)
        not VehicleRiskProfile(applicationId == $id)
    then
        var currentYear = 2024;
        var vehicleAge = currentYear - app.vehicleYear;

        // Determine vehicle category based on type
        var category = "Standard";
        if (app.vehicleType == "sports" || app.vehicleType == "motorcycle") {
            category = "Very High Risk";
        } else if (app.vehicleType == "suv" || app.vehicleType == "truck") {
            category = "High Risk";
        } else if (app.vehicleType == "sedan" || app.vehicleType == "minivan") {
            category = "Low Risk";
        }

        // Adjust for vehicle age
        if (vehicleAge > 15) {
            category = "High Risk"; // Old vehicles have more issues
        }

        // Safety rating based on features
        var safetyCount = 0;
        if (app.antiTheft) safetyCount++;
        if (app.airbags) safetyCount++;
        if (app.absSystem) safetyCount++;

        var safetyRating = "Poor";
        if (safetyCount == 3) {
            safetyRating = "Excellent";
        } else if (safetyCount == 2) {
            safetyRating = "Good";
        } else if (safetyCount == 1) {
            safetyRating = "Average";
        }

        console.log("Vehicle Profile: " + app.vehicleYear + " " + app.vehicleMake + " " + app.vehicleModel +
                    " - " + category + ", Safety: " + safetyRating);

        drools.insert({
            type: "com.insurance.auto.VehicleRiskProfile",
            applicationId: app.applicationId,
            vehicleCategory: category,
            safetyRating: safetyRating,
            vehicleAge: vehicleAge
        });
end

// ============================================================================
// PHASE 3: AUTO-DECLINE RULES (salience 85)
// ============================================================================

rule "Decline - DUI History"
    salience 85
    when
        $app: InsuranceApplication($id: applicationId, dui == true)
        not DeclineReason(applicationId == $id)
    then
        console.log("AUTO-DECLINE: " + app.applicantName + " - DUI history");
        drools.insert({
            type: "com.insurance.auto.DeclineReason",
            applicationId: app.applicationId,
            reason: "Applicants with DUI history are not eligible for coverage",
            code: "DUI_HISTORY"
        });
end

rule "Decline - Too Many Accidents"
    salience 85
    when
        $app: InsuranceApplication($id: applicationId, accidentCount >= 3)
        not DeclineReason(applicationId == $id)
    then
        console.log("AUTO-DECLINE: " + app.applicantName + " - Excessive accidents (" + app.accidentCount + ")");
        drools.insert({
            type: "com.insurance.auto.DeclineReason",
            applicationId: app.applicationId,
            reason: "Too many at-fault accidents in the past 5 years",
            code: "EXCESSIVE_ACCIDENTS"
        });
end

rule "Decline - Too Many Violations"
    salience 85
    when
        $app: InsuranceApplication($id: applicationId, violationCount >= 5)
        not DeclineReason(applicationId == $id)
    then
        console.log("AUTO-DECLINE: " + app.applicantName + " - Excessive violations (" + app.violationCount + ")");
        drools.insert({
            type: "com.insurance.auto.DeclineReason",
            applicationId: app.applicationId,
            reason: "Too many traffic violations in the past 3 years",
            code: "EXCESSIVE_VIOLATIONS"
        });
end

rule "Decline - Very Young With Accidents"
    salience 85
    when
        $app: InsuranceApplication($id: applicationId, age < 21, accidentCount >= 2)
        not DeclineReason(applicationId == $id)
    then
        console.log("AUTO-DECLINE: " + app.applicantName + " - Young driver with multiple accidents");
        drools.insert({
            type: "com.insurance.auto.DeclineReason",
            applicationId: app.applicationId,
            reason: "Drivers under 21 with 2+ accidents are not eligible",
            code: "YOUNG_HIGH_RISK"
        });
end

// ============================================================================
// PHASE 4: PREMIUM CALCULATION (salience 70)
// ============================================================================

rule "Calculate Premium - Standard Coverage"
    salience 70
    when
        $app: InsuranceApplication($id: applicationId)
        $driver: DriverRiskProfile(applicationId == $id)
        $vehicle: VehicleRiskProfile(applicationId == $id)
        not DeclineReason(applicationId == $id)
        not PremiumCalculation(applicationId == $id)
    then
        // Base premium for standard coverage
        var basePremium = 1200.0;

        // Driver multiplier based on risk score
        var driverMultiplier = 1.0;
        if (driver.riskScore <= 30) {
            driverMultiplier = 0.85;
        } else if (driver.riskScore <= 50) {
            driverMultiplier = 1.0;
        } else if (driver.riskScore <= 70) {
            driverMultiplier = 1.35;
        } else {
            driverMultiplier = 1.75;
        }

        // Vehicle multiplier
        var vehicleMultiplier = 1.0;
        if (vehicle.vehicleCategory == "Low Risk") {
            vehicleMultiplier = 0.90;
        } else if (vehicle.vehicleCategory == "High Risk") {
            vehicleMultiplier = 1.25;
        } else if (vehicle.vehicleCategory == "Very High Risk") {
            vehicleMultiplier = 1.60;
        }

        // Location multiplier (simplified - would use ZIP code database)
        var locationMultiplier = 1.0;
        var zipPrefix = app.zipCode.substring(0, 2);
        if (zipPrefix == "94" || zipPrefix == "10" || zipPrefix == "90") {
            locationMultiplier = 1.20; // Urban California, NYC, LA
        } else if (zipPrefix == "33" || zipPrefix == "77") {
            locationMultiplier = 1.15; // Florida, Texas urban
        }

        // Calculate discounts
        var discountPercent = 0.0;

        // Multi-policy discount
        if (app.multiPolicy) {
            discountPercent = discountPercent + 15.0;
        }

        // Good driver discount
        if (app.accidentCount == 0 && app.violationCount == 0) {
            discountPercent = discountPercent + 10.0;
        }

        // Safety features discount
        if (app.antiTheft && app.airbags && app.absSystem) {
            discountPercent = discountPercent + 8.0;
        }

        // Low mileage discount
        if (app.annualMileage < 7500) {
            discountPercent = discountPercent + 5.0;
        }

        // Garage parked discount
        if (app.garageParked) {
            discountPercent = discountPercent + 3.0;
        }

        // Existing customer discount
        if (app.existingCustomer) {
            discountPercent = discountPercent + 5.0;
        }

        // Cap total discount at 35%
        if (discountPercent > 35.0) {
            discountPercent = 35.0;
        }

        // Calculate final premium
        var premiumBeforeDiscount = basePremium * driverMultiplier * vehicleMultiplier * locationMultiplier;
        var finalPremium = premiumBeforeDiscount * (1 - discountPercent / 100);

        console.log("Premium Calculation: " + app.applicantName);
        console.log("  Base: $" + basePremium + " × Driver: " + driverMultiplier.toFixed(2) +
                    " × Vehicle: " + vehicleMultiplier.toFixed(2) + " × Location: " + locationMultiplier.toFixed(2));
        console.log("  Discount: " + discountPercent.toFixed(1) + "% → Final: $" + finalPremium.toFixed(2));

        drools.insert({
            type: "com.insurance.auto.PremiumCalculation",
            applicationId: app.applicationId,
            basePremium: basePremium,
            driverMultiplier: driverMultiplier,
            vehicleMultiplier: vehicleMultiplier,
            locationMultiplier: locationMultiplier,
            discountPercent: discountPercent,
            finalPremium: finalPremium
        });
end

// ============================================================================
// PHASE 5: POLICY DECISION (salience 60)
// ============================================================================

rule "Policy Decision - Approved"
    salience 60
    when
        $app: InsuranceApplication($id: applicationId)
        $premium: PremiumCalculation(applicationId == $id)
        not DeclineReason(applicationId == $id)
        not PolicyDecision(applicationId == $id)
    then
        var monthlyPayment = premium.finalPremium / 12;

        console.log("POLICY APPROVED: " + app.applicantName + " - $" + premium.finalPremium.toFixed(2) + "/year");

        drools.insert({
            type: "com.insurance.auto.PolicyDecision",
            applicationId: app.applicationId,
            approved: true,
            annualPremium: premium.finalPremium,
            monthlyPayment: monthlyPayment,
            coverageLevel: "Standard",
            reason: "Application approved based on risk assessment"
        });
end

rule "Policy Decision - Declined"
    salience 60
    when
        $app: InsuranceApplication($id: applicationId)
        $decline: DeclineReason(applicationId == $id)
        not PolicyDecision(applicationId == $id)
    then
        console.log("POLICY DECLINED: " + app.applicantName + " - " + decline.reason);

        drools.insert({
            type: "com.insurance.auto.PolicyDecision",
            applicationId: app.applicationId,
            approved: false,
            annualPremium: 0,
            monthlyPayment: 0,
            coverageLevel: "None",
            reason: decline.reason
        });
end

// ============================================================================
// QUERIES
// ============================================================================

query "PolicyDecisions"
    $decision: PolicyDecision()
end

query "ApprovedPolicies"
    $decision: PolicyDecision(approved == true)
end

query "DeclinedPolicies"
    $decision: PolicyDecision(approved == false)
end

query "HighRiskDrivers"
    $driver: DriverRiskProfile(riskScore > 60)
end

query "PremiumsByRange"
    $premium: PremiumCalculation(finalPremium > 0)
end
