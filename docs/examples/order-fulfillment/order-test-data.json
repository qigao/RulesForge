        {"itemId": "ITEM-002", "productId": "PROD-002", "quantity": 1, "unitPrice": 49.99, "weight": 2.5, "category": "electronics"}
      ],
      "_expectedResult": {
        "valid": true,
        "discounts": ["Gold loyalty 10%", "Electronics 20%", "Free shipping"],
