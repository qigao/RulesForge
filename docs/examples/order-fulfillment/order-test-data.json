    {
      "scenario": "Bulk Order - Platinum Customer",
      "order": {
        "orderId": "ORD-002",
        "customerId": "CUST-002",
        "customerTier": "platinum",
        "shippingCountry": "US",
        "shippingState": "NY",
        "shippingCity": "New York",
        "shippingZip": "10001",
        "giftOrder": false,
        "expressShipping": true
      },
      "items": [
        {"itemId": "ITEM-003", "productId": "PROD-001", "quantity": 15, "unitPrice": 79.99, "weight": 0.5, "category": "electronics"}
      ],
      "_expectedResult": {
        "valid": true,
        "discounts": ["Platinum loyalty 15%", "Bulk order 10%", "Electronics 20%"],
        "shippingMethod": "Express",
        "notes": "Bulk discount + platinum + promo, express shipping"
      }
    },
    {
      "scenario": "International Order",
      "order": {
        "orderId": "ORD-003",
        "customerId": "CUST-003",
        "customerTier": "standard",
        "shippingCountry": "CA",
        "shippingState": "ON",
        "shippingCity": "Toronto",
        "shippingZip": "M5V 1J1",
        "giftOrder": true,
        "expressShipping": false
      },
      "items": [
        {"itemId": "ITEM-004", "productId": "PROD-004", "quantity": 1, "unitPrice": 129.99, "weight": 1.8, "category": "electronics"}
      ],
      "_expectedResult": {
        "valid": true,
        "shippingMethod": "International",
        "shippingCost": "~$27.69",
        "notes": "International shipping rates apply"
      }
    },
    {
      "scenario": "Insufficient Stock",
      "order": {
        "orderId": "ORD-004",
        "customerId": "CUST-004",
        "customerTier": "silver",
        "shippingCountry": "US",
        "shippingState": "FL",
        "shippingCity": "Miami",
        "shippingZip": "33101",
        "giftOrder": false,
        "expressShipping": false
      },
      "items": [
        {"itemId": "ITEM-005", "productId": "PROD-003", "quantity": 100, "unitPrice": 39.99, "weight": 0.3, "category": "electronics"}
      ],
      "_expectedResult": {
        "valid": false,
        "reason": "Insufficient stock - only 85 available across all warehouses",
        "notes": "Order should fail validation"
      }
    },
    {
      "scenario": "Low Stock Alert Trigger",
      "order": {
        "orderId": "ORD-005",
        "customerId": "CUST-005",
        "customerTier": "gold",
        "shippingCountry": "US",
        "shippingState": "CA",
        "shippingCity": "San Diego",
        "shippingZip": "92101",
        "giftOrder": false,
        "expressShipping": false
      },
      "items": [
        {"itemId": "ITEM-006", "productId": "PROD-003", "quantity": 3, "unitPrice": 39.99, "weight": 0.3, "category": "electronics"}
      ],
      "_expectedResult": {
        "valid": true,
        "alerts": ["LOW_STOCK for PROD-003 at WH-WEST"],
        "notes": "Order succeeds but triggers low stock alert (5-3=2, below reorder point of 10)"
      }
    }
