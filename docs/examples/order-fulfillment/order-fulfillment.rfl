package com.ecommerce

// ============================================================================
// ORDER FULFILLMENT RULES
// E-commerce order processing with inventory, pricing, and shipping logic.
// ============================================================================

// --- Type Declarations ---

declare Order
    orderId: String
    customerId: String
    customerTier: String
    orderDate: long
    shippingCountry: String
    shippingState: String
    shippingCity: String
    shippingZip: String
    requestedDeliveryDate: long
    giftOrder: boolean
    expressShipping: boolean
end

declare OrderItem
    itemId: String
    orderId: String
    productId: String
    productName: String
    quantity: int
    unitPrice: double
    category: String
    weight: double
end

declare Inventory
    warehouseId: String
    productId: String
    quantityAvailable: int
    quantityReserved: int
    reorderPoint: int
end

declare Warehouse
    warehouseId: String
    name: String
    state: String
    zipCode: String
end

declare Promotion
    promoId: String
    promoCode: String
    discountType: String
    discountValue: double
    minOrderAmount: double
    validCategory: String
    active: boolean
end

declare OrderValidation
    orderId: String
    isValid: boolean
    issue: String
end

declare ItemDiscount
    itemId: String
    orderId: String
    discountType: String
    discountAmount: double
    reason: String
end

declare OrderDiscount
    orderId: String
    discountType: String
    discountAmount: double
    reason: String
end

declare PricingResult
    orderId: String
    subtotal: double
    itemDiscounts: double
    orderDiscounts: double
    shippingCost: double
    taxAmount: double
    totalAmount: double
end

declare FulfillmentPlan
    orderId: String
    itemId: String
    warehouseId: String
    carrier: String
    shippingMethod: String
    shippingCost: double
end

declare InventoryAlert
    warehouseId: String
    productId: String
    alertType: String
    currentQuantity: int
    threshold: int
end

declare OrderStatus
    orderId: String
    status: String
    message: String
end

// ============================================================================
// PHASE 1: ORDER VALIDATION (salience 100)
// ============================================================================

rule "Validate - Check Item Inventory"
    salience 100
    when
        $item: OrderItem($orderId: orderId, $prodId: productId, $qty: quantity)
        $totalAvailable: Number() from accumulate(
            Inventory(productId == $prodId, $avail: quantityAvailable, $reserved: quantityReserved),
            sum($avail - $reserved)
        )
        eval($totalAvailable.intValue() < $qty)
        not OrderValidation(orderId == $orderId, isValid == false)
    then
        insert OrderValidation {
            orderId: $item.orderId,
            isValid: false,
            issue: "Insufficient stock for product " + $item.productId
        }
end

rule "Validate - Order Passes"
    salience 90
    when
        OrderItem($orderId: orderId)
        $order: Order(orderId == $orderId)
        not OrderValidation(orderId == $orderId, isValid == false)
        not OrderValidation(orderId == $orderId, isValid == true)
    then
        insert OrderValidation {
            orderId: $order.orderId,
            isValid: true,
            issue: ""
        }
end

// ============================================================================
// PHASE 2: ITEM-LEVEL DISCOUNTS (salience 80)
// ============================================================================

rule "Discount - Bulk Order Item"
    salience 80
    when
        $item: OrderItem($itemId: itemId, $orderId: orderId, quantity >= 10, $price: unitPrice, $qty: quantity)
        OrderValidation(orderId == $orderId, isValid == true)
        not ItemDiscount(itemId == $itemId, discountType == "BULK")
    then
        insert ItemDiscount {
            itemId: $item.itemId,
            orderId: $item.orderId,
            discountType: "BULK",
            discountAmount: $item.unitPrice * $item.quantity * 0.10,
            reason: "10% bulk order discount (10+ items)"
        }
end

rule "Discount - Category Promotion"
    salience 80
    when
        $item: OrderItem($itemId: itemId, $orderId: orderId, $cat: category, $price: unitPrice, $qty: quantity)
        $promo: Promotion(validCategory == $cat, active == true, discountType == "percent")
        OrderValidation(orderId == $orderId, isValid == true)
        not ItemDiscount(itemId == $itemId, discountType == "PROMO")
    then
        insert ItemDiscount {
            itemId: $item.itemId,
            orderId: $item.orderId,
            discountType: "PROMO",
            discountAmount: $item.unitPrice * $item.quantity * ($promo.discountValue / 100),
            reason: $promo.promoCode + " - " + $promo.discountValue + "% off"
        }
end

// ============================================================================
// PHASE 3: ORDER-LEVEL DISCOUNTS (salience 75)
// ============================================================================

rule "Discount - Platinum Customer"
    salience 75
    when
        $order: Order($orderId: orderId, customerTier == "platinum")
        OrderValidation(orderId == $orderId, isValid == true)
        $subtotal: Number() from accumulate(
            OrderItem(orderId == $orderId, $price: unitPrice, $qty: quantity),
            sum($price * $qty)
        )
        not OrderDiscount(orderId == $orderId, discountType == "LOYALTY")
    then
        insert OrderDiscount {
            orderId: $order.orderId,
            discountType: "LOYALTY",
            discountAmount: $subtotal.doubleValue() * 0.15,
            reason: "Platinum member 15% discount"
        }
end

rule "Discount - Gold Customer"
    salience 75
    when
        $order: Order($orderId: orderId, customerTier == "gold")
        OrderValidation(orderId == $orderId, isValid == true)
        $subtotal: Number() from accumulate(
            OrderItem(orderId == $orderId, $price: unitPrice, $qty: quantity),
            sum($price * $qty)
        )
        not OrderDiscount(orderId == $orderId, discountType == "LOYALTY")
    then
        insert OrderDiscount {
            orderId: $order.orderId,
            discountType: "LOYALTY",
            discountAmount: $subtotal.doubleValue() * 0.10,
            reason: "Gold member 10% discount"
        }
end

rule "Discount - Silver Customer"
    salience 75
    when
        $order: Order($orderId: orderId, customerTier == "silver")
        OrderValidation(orderId == $orderId, isValid == true)
        $subtotal: Number() from accumulate(
            OrderItem(orderId == $orderId, $price: unitPrice, $qty: quantity),
            sum($price * $qty)
        )
        not OrderDiscount(orderId == $orderId, discountType == "LOYALTY")
    then
        insert OrderDiscount {
            orderId: $order.orderId,
            discountType: "LOYALTY",
            discountAmount: $subtotal.doubleValue() * 0.05,
            reason: "Silver member 5% discount"
        }
end

// ============================================================================
// PHASE 4: SHIPPING CALCULATION (salience 70)
// ============================================================================

rule "Shipping - Free Ground Over $75"
    salience 70
    activation-group "shipping-cost"
    when
        $order: Order($orderId: orderId, shippingCountry == "US", expressShipping == false)
        OrderValidation(orderId == $orderId, isValid == true)
        $subtotal: Number(doubleValue >= 75) from accumulate(
            OrderItem(orderId == $orderId, $price: unitPrice, $qty: quantity),
            sum($price * $qty)
        )
        not OrderDiscount(orderId == $orderId, discountType == "FREE_SHIPPING")
    then
        insert OrderDiscount {
            orderId: $order.orderId,
            discountType: "FREE_SHIPPING",
            discountAmount: 0,
            reason: "Free ground shipping on orders over $75"
        }
end

rule "Shipping - Express Domestic"
    salience 70
    activation-group "shipping-cost"
    when
        $order: Order($orderId: orderId, shippingCountry == "US", expressShipping == true)
        OrderValidation(orderId == $orderId, isValid == true)
        $totalWeight: Number() from accumulate(
            OrderItem(orderId == $orderId, $w: weight, $qty: quantity),
            sum($w * $qty)
        )
        not OrderDiscount(orderId == $orderId, discountType == "SHIPPING_CALC")
    then
        insert OrderDiscount {
            orderId: $order.orderId,
            discountType: "SHIPPING_CALC",
            discountAmount: -(12.99 + $totalWeight.doubleValue() * 0.50),
            reason: "Express shipping"
        }
end

rule "Shipping - Standard Domestic"
    salience 65
    activation-group "shipping-cost"
    when
        $order: Order($orderId: orderId, shippingCountry == "US")
        OrderValidation(orderId == $orderId, isValid == true)
        $totalWeight: Number() from accumulate(
            OrderItem(orderId == $orderId, $w: weight, $qty: quantity),
            sum($w * $qty)
        )
        not OrderDiscount(orderId == $orderId, discountType == "FREE_SHIPPING")
        not OrderDiscount(orderId == $orderId, discountType == "SHIPPING_CALC")
    then
        insert OrderDiscount {
            orderId: $order.orderId,
            discountType: "SHIPPING_CALC",
            discountAmount: -(5.99 + $totalWeight.doubleValue() * 0.25),
            reason: "Standard shipping"
        }
end

rule "Shipping - International"
    salience 70
    activation-group "shipping-cost"
    when
        $order: Order($orderId: orderId, shippingCountry != "US")
        OrderValidation(orderId == $orderId, isValid == true)
        $totalWeight: Number() from accumulate(
            OrderItem(orderId == $orderId, $w: weight, $qty: quantity),
            sum($w * $qty)
        )
        not OrderDiscount(orderId == $orderId, discountType == "SHIPPING_CALC")
    then
        insert OrderDiscount {
            orderId: $order.orderId,
            discountType: "SHIPPING_CALC",
            discountAmount: -(24.99 + $totalWeight.doubleValue() * 1.50),
            reason: "International shipping"
        }
end

// ============================================================================
// PHASE 5: PRICING SUMMARY (salience 60)
// ============================================================================

rule "Calculate Final Pricing"
    salience 60
    when
        $order: Order($orderId: orderId)
        OrderValidation(orderId == $orderId, isValid == true)
        $subtotal: Number() from accumulate(
            OrderItem(orderId == $orderId, $price: unitPrice, $qty: quantity),
            sum($price * $qty)
        )
        $itemDiscounts: Number() from accumulate(
            ItemDiscount(orderId == $orderId, $amt: discountAmount),
            sum($amt)
        )
        $orderDiscounts: Number() from accumulate(
            OrderDiscount(orderId == $orderId, discountType != "SHIPPING_CALC", $amt: discountAmount),
            sum($amt)
        )
        $shippingCost: Number() from accumulate(
            OrderDiscount(orderId == $orderId, discountType == "SHIPPING_CALC", $amt: discountAmount),
            sum($amt)
        )
        not PricingResult(orderId == $orderId)
    then
        insert PricingResult {
            orderId: $order.orderId,
            subtotal: $subtotal.doubleValue(),
            itemDiscounts: $itemDiscounts.doubleValue(),
            orderDiscounts: $orderDiscounts.doubleValue(),
            shippingCost: abs($shippingCost.doubleValue()),
            taxAmount: ($subtotal.doubleValue() - $itemDiscounts.doubleValue() - $orderDiscounts.doubleValue()) * 0.0875,
            totalAmount: ($subtotal.doubleValue() - $itemDiscounts.doubleValue() - $orderDiscounts.doubleValue()) * 1.0875 + abs($shippingCost.doubleValue())
        }
end

// ============================================================================
// PHASE 6: FULFILLMENT PLANNING (salience 50)
// ============================================================================

rule "Fulfillment - Same State Warehouse"
    salience 50
    when
        $order: Order($orderId: orderId, $state: shippingState, expressShipping == false)
        $item: OrderItem(orderId == $orderId, $itemId: itemId, $prodId: productId, $qty: quantity)
        OrderValidation(orderId == $orderId, isValid == true)
        $warehouse: Warehouse($whId: warehouseId, state == $state)
        $inv: Inventory(warehouseId == $whId, productId == $prodId, quantityAvailable >= $qty)
        not FulfillmentPlan(orderId == $orderId, itemId == $itemId)
    then
        insert FulfillmentPlan {
            orderId: $order.orderId,
            itemId: $item.itemId,
            warehouseId: $warehouse.warehouseId,
            carrier: "UPS",
            shippingMethod: "Ground",
            shippingCost: 5.99
        }
end

rule "Fulfillment - Any Available Warehouse"
    salience 40
    when
        $order: Order($orderId: orderId)
        $item: OrderItem(orderId == $orderId, $itemId: itemId, $prodId: productId, $qty: quantity)
        OrderValidation(orderId == $orderId, isValid == true)
        $warehouse: Warehouse($whId: warehouseId)
        $inv: Inventory(warehouseId == $whId, productId == $prodId, quantityAvailable >= $qty)
        not FulfillmentPlan(orderId == $orderId, itemId == $itemId)
    then
        insert FulfillmentPlan {
            orderId: $order.orderId,
            itemId: $item.itemId,
            warehouseId: $warehouse.warehouseId,
            carrier: "FedEx",
            shippingMethod: "Ground",
            shippingCost: 7.99
        }
end

// ============================================================================
// PHASE 7: INVENTORY ALERTS (salience 30)
// ============================================================================

rule "Alert - Low Stock"
    salience 30
    when
        $inv: Inventory($whId: warehouseId, $prodId: productId, $avail: quantityAvailable, $reorder: reorderPoint)
        eval($avail <= $reorder && $avail > 0)
        not InventoryAlert(warehouseId == $whId, productId == $prodId, alertType == "LOW_STOCK")
    then
        insert InventoryAlert {
            warehouseId: $inv.warehouseId,
            productId: $inv.productId,
            alertType: "LOW_STOCK",
            currentQuantity: $inv.quantityAvailable,
            threshold: $inv.reorderPoint
        }
end

rule "Alert - Out of Stock"
    salience 30
    when
        $inv: Inventory($whId: warehouseId, $prodId: productId, quantityAvailable == 0)
        not InventoryAlert(warehouseId == $whId, productId == $prodId, alertType == "OUT_OF_STOCK")
    then
        insert InventoryAlert {
            warehouseId: $inv.warehouseId,
            productId: $inv.productId,
            alertType: "OUT_OF_STOCK",
            currentQuantity: 0,
            threshold: 0
        }
end

// ============================================================================
// PHASE 8: ORDER STATUS (salience 20)
// ============================================================================

rule "Status - Order Confirmed"
    salience 20
    when
        $order: Order($orderId: orderId)
        OrderValidation(orderId == $orderId, isValid == true)
        PricingResult(orderId == $orderId)
        forall(
            $item: OrderItem(orderId == $orderId)
            FulfillmentPlan(orderId == $orderId, itemId == $item.itemId)
        )
        not OrderStatus(orderId == $orderId)
    then
        insert OrderStatus {
            orderId: $order.orderId,
            status: "CONFIRMED",
            message: "Order confirmed and ready for fulfillment"
        }
end

rule "Status - Order Failed Validation"
    salience 20
    when
        $order: Order($orderId: orderId)
        $validation: OrderValidation(orderId == $orderId, isValid == false)
        not OrderStatus(orderId == $orderId)
    then
        insert OrderStatus {
            orderId: $order.orderId,
            status: "FAILED",
            message: "Order failed: " + $validation.issue
        }
end

// ============================================================================
// QUERIES
// ============================================================================

query "OrderPricing"
    $pricing: PricingResult()
end

query "FulfillmentPlans"
    $plan: FulfillmentPlan()
end

query "InventoryAlerts"
    $alert: InventoryAlert()
end

query "OrderStatuses"
    $status: OrderStatus()
end

query "ConfirmedOrders"
    $status: OrderStatus(status == "CONFIRMED")
end
