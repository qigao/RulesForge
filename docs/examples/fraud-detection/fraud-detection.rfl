package com.bank.fraud

// ============================================================================
// FRAUD DETECTION RULES
// Real-time transaction monitoring with Complex Event Processing (CEP).
// Demonstrates temporal operators, entry points, and pattern detection.
// ============================================================================

// --- Type Declarations ---

declare Transaction
    transactionId: String
    accountId: String
    cardNumber: String
    amount: double
    currency: String
    merchantId: String
    merchantCategory: String
    merchantCountry: String
    merchantCity: String
    channel: String
    timestamp: long
    latitude: double
    longitude: double
    ipAddress: String
end

declare AccountProfile
    accountId: String
    accountType: String
    avgMonthlySpend: double
    avgTransactionAmount: double
    primaryCountry: String
    lastKnownLatitude: double
    lastKnownLongitude: double
    lastTransactionTime: long
end

declare FraudSignal
    transactionId: String
    signalType: String
    severity: String
    score: int
    description: String
    timestamp: long
end

declare FraudAlert
    alertId: String
    transactionId: String
    accountId: String
    totalScore: int
    riskLevel: String
    action: String
    timestamp: long
end

declare HighRiskCountry
    countryCode: String
    riskLevel: String
end

// ============================================================================
// PHASE 1: AMOUNT ANOMALY DETECTION (salience 100)
// ============================================================================

rule "Signal - Large Transaction Amount"
    salience 100
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $amt: amount) from entry-point "transaction-stream"
        $profile: AccountProfile(accountId == $acct, avgTransactionAmount > 0)
        eval($amt > $profile.avgTransactionAmount * 3)
        not FraudSignal(transactionId == $id, signalType == "LARGE_AMOUNT")
    then
        insert FraudSignal {
            transactionId = $txn.transactionId,
            signalType = "LARGE_AMOUNT",
            severity = "Medium",
            score = 20,
            description = "Transaction significantly larger than average",
            timestamp = $txn.timestamp
        }
end

rule "Signal - Very Large Transaction"
    salience 100
    when
        $txn: Transaction($id: transactionId, amount > 5000) from entry-point "transaction-stream"
        not FraudSignal(transactionId == $id, signalType == "VERY_LARGE_AMOUNT")
    then
        insert FraudSignal {
            transactionId = $txn.transactionId,
            signalType = "VERY_LARGE_AMOUNT",
            severity = "High",
            score = 35,
            description = "Transaction exceeds $5,000 threshold",
            timestamp = $txn.timestamp
        }
end

rule "Signal - Round Amount Suspicious"
    salience 100
    when
        $txn: Transaction($id: transactionId, $amt: amount) from entry-point "transaction-stream"
        eval($amt >= 100 && $amt == floor($amt) && ($amt / 100) == floor($amt / 100))
        not FraudSignal(transactionId == $id, signalType == "ROUND_AMOUNT")
    then
        insert FraudSignal {
            transactionId = $txn.transactionId,
            signalType = "ROUND_AMOUNT",
            severity = "Low",
            score = 15,
            description = "Large round amount often indicates card testing",
            timestamp = $txn.timestamp
        }
end

rule "Signal - Just Under Reporting Threshold"
    salience 100
    when
        $txn: Transaction($id: transactionId, amount >= 9000, amount < 10000) from entry-point "transaction-stream"
        not FraudSignal(transactionId == $id, signalType == "STRUCTURING")
    then
        insert FraudSignal {
            transactionId = $txn.transactionId,
            signalType = "STRUCTURING",
            severity = "High",
            score = 30,
            description = "Amount just below reporting threshold - possible structuring",
            timestamp = $txn.timestamp
        }
end

// ============================================================================
// PHASE 2: GEOGRAPHIC ANOMALY DETECTION (salience 95)
// ============================================================================

rule "Signal - High Risk Country"
    salience 95
    when
        $txn: Transaction($id: transactionId, $country: merchantCountry) from entry-point "transaction-stream"
        HighRiskCountry(countryCode == $country)
        not FraudSignal(transactionId == $id, signalType == "HIGH_RISK_COUNTRY")
    then
        insert FraudSignal {
            transactionId = $txn.transactionId,
            signalType = "HIGH_RISK_COUNTRY",
            severity = "High",
            score = 45,
            description = "Transaction from high-risk country",
            timestamp = $txn.timestamp
        }
end

rule "Signal - New Country"
    salience 95
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $country: merchantCountry) from entry-point "transaction-stream"
        $profile: AccountProfile(accountId == $acct, primaryCountry != $country)
        not FraudSignal(transactionId == $id, signalType == "NEW_COUNTRY")
    then
        insert FraudSignal {
            transactionId = $txn.transactionId,
            signalType = "NEW_COUNTRY",
            severity = "Medium",
            score = 25,
            description = "First transaction in new country",
            timestamp = $txn.timestamp
        }
end

rule "Signal - Impossible Travel"
    salience 95
    when
        $txn: Transaction($id: transactionId,
                          $acct: accountId,
                          $ts: timestamp,
                          $lat: latitude,
                          $lon: longitude) from entry-point "transaction-stream"
        AccountProfile(accountId == $acct,
                       $prevTs: lastTransactionTime,
                       $prevLat: lastKnownLatitude,
                       $prevLon: lastKnownLongitude)
        eval($ts >= $prevTs && ($ts - $prevTs) <= 3600000)
        eval(3959 * acos(
            min(
                max(
                    sin($prevLat * pi / 180) * sin($lat * pi / 180) +
                    cos($prevLat * pi / 180) * cos($lat * pi / 180) *
                    cos(($lon - $prevLon) * pi / 180),
                    -1
                ),
                1
            )
        ) > 500)
        not FraudSignal(transactionId == $id, signalType == "IMPOSSIBLE_TRAVEL")
    then
        insert FraudSignal {
            transactionId = $txn.transactionId,
            signalType = "IMPOSSIBLE_TRAVEL",
            severity = "High",
            score = 50,
            description = "Transaction location is impossible given the prior location and time",
            timestamp = $txn.timestamp
        }
end

// ============================================================================
// PHASE 3: VELOCITY DETECTION (salience 90)
// Uses accumulate to count transactions in time windows
// ============================================================================

rule "Signal - Rapid Fire Transactions"
    salience 90
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $ts: timestamp) from entry-point "transaction-stream"
        $count: Number(intValue >= 5) from accumulate(
            Transaction(
                accountId == $acct,
                transactionId != $id,
                timestamp > ($ts - 60000),
                timestamp < $ts
            ) from entry-point "transaction-stream",
            count(1)
        )
        not FraudSignal(transactionId == $id, signalType == "RAPID_FIRE")
    then
        insert FraudSignal {
            transactionId = $txn.transactionId,
            signalType = "RAPID_FIRE",
            severity = "High",
            score = 40,
            description = "Multiple transactions in the last minute",
            timestamp = $txn.timestamp
        }
end

rule "Signal - High Frequency"
    salience 90
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $ts: timestamp) from entry-point "transaction-stream"
        $count: Number(intValue >= 10) from accumulate(
            Transaction(
                accountId == $acct,
                transactionId != $id,
                timestamp > ($ts - 600000),
                timestamp < $ts
            ) from entry-point "transaction-stream",
            count(1)
        )
        not FraudSignal(transactionId == $id, signalType == "HIGH_FREQUENCY")
    then
        insert FraudSignal {
            transactionId = $txn.transactionId,
            signalType = "HIGH_FREQUENCY",
            severity = "Medium",
            score = 30,
            description = "Many transactions in the last 10 minutes",
            timestamp = $txn.timestamp
        }
end

rule "Signal - ATM Hammering"
    salience 90
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $ts: timestamp, channel == "atm") from entry-point "transaction-stream"
        $count: Number(intValue >= 3) from accumulate(
            Transaction(
                accountId == $acct,
                transactionId != $id,
                channel == "atm",
                timestamp > ($ts - 1800000),
                timestamp < $ts
            ) from entry-point "transaction-stream",
            count(1)
        )
        not FraudSignal(transactionId == $id, signalType == "ATM_HAMMERING")
    then
        insert FraudSignal {
            transactionId = $txn.transactionId,
            signalType = "ATM_HAMMERING",
            severity = "High",
            score = 35,
            description = "Multiple ATM withdrawals in the last 30 minutes",
            timestamp = $txn.timestamp
        }
end

// ============================================================================
// PHASE 4: AGGREGATE RISK SCORING (salience 80)
// ============================================================================

rule "Create Alert - Critical Risk"
    salience 80
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $ts: timestamp) from entry-point "transaction-stream"
        $totalScore: Number(intValue > 100) from accumulate(
            FraudSignal(transactionId == $id, $score: score),
            sum($score)
        )
        not FraudAlert(transactionId == $id)
    then
        insert FraudAlert {
            alertId = $txn.transactionId,
            transactionId = $txn.transactionId,
            accountId = $txn.accountId,
            totalScore = 0,
            riskLevel = "Critical",
            action = "block_and_freeze",
            timestamp = $txn.timestamp
        }
end

rule "Create Alert - Very High Risk"
    salience 79
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $ts: timestamp) from entry-point "transaction-stream"
        $totalScore: Number(intValue > 75, intValue <= 100) from accumulate(
            FraudSignal(transactionId == $id, $score: score),
            sum($score)
        )
        not FraudAlert(transactionId == $id)
    then
        insert FraudAlert {
            alertId = $txn.transactionId,
            transactionId = $txn.transactionId,
            accountId = $txn.accountId,
            totalScore = 0,
            riskLevel = "Very High",
            action = "block",
            timestamp = $txn.timestamp
        }
end

rule "Create Alert - High Risk"
    salience 78
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $ts: timestamp) from entry-point "transaction-stream"
        $totalScore: Number(intValue > 50, intValue <= 75) from accumulate(
            FraudSignal(transactionId == $id, $score: score),
            sum($score)
        )
        not FraudAlert(transactionId == $id)
    then
        insert FraudAlert {
            alertId = $txn.transactionId,
            transactionId = $txn.transactionId,
            accountId = $txn.accountId,
            totalScore = 0,
            riskLevel = "High",
            action = "review",
            timestamp = $txn.timestamp
        }
end

rule "Create Alert - Medium Risk"
    salience 77
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $ts: timestamp) from entry-point "transaction-stream"
        $totalScore: Number(intValue > 25, intValue <= 50) from accumulate(
            FraudSignal(transactionId == $id, $score: score),
            sum($score)
        )
        not FraudAlert(transactionId == $id)
    then
        insert FraudAlert {
            alertId = $txn.transactionId,
            transactionId = $txn.transactionId,
            accountId = $txn.accountId,
            totalScore = 0,
            riskLevel = "Medium",
            action = "allow_and_log",
            timestamp = $txn.timestamp
        }
end

rule "Create Alert - Low Risk"
    salience 76
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $ts: timestamp) from entry-point "transaction-stream"
        $totalScore: Number(intValue > 0, intValue <= 25) from accumulate(
            FraudSignal(transactionId == $id, $score: score),
            sum($score)
        )
        not FraudAlert(transactionId == $id)
    then
        insert FraudAlert {
            alertId = $txn.transactionId,
            transactionId = $txn.transactionId,
            accountId = $txn.accountId,
            totalScore = 0,
            riskLevel = "Low",
            action = "allow",
            timestamp = $txn.timestamp
        }
end

// ============================================================================
// QUERIES
// ============================================================================

query "ActiveAlerts"
    $alert: FraudAlert()
end

query "AllSignals"
    $signal: FraudSignal()
end

query "HighRiskAlerts"
    $alert: FraudAlert(riskLevel in ("High", "Very High", "Critical"))
end

query "BlockedTransactions"
    $alert: FraudAlert(action == "block" || action == "block_and_freeze")
end

query "SignalsByTransaction"
    $signal: FraudSignal()
end
