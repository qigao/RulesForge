package com.bank.fraud

// ============================================================================
// FRAUD DETECTION RULES
// Real-time transaction monitoring with Complex Event Processing (CEP).
// Demonstrates temporal operators, entry points, and pattern detection.
// ============================================================================

// --- Type Declarations ---

declare Transaction
    transactionId: String
    accountId: String
    cardNumber: String
    amount: double
    currency: String
    merchantId: String
    merchantCategory: String
    merchantCountry: String
    merchantCity: String
    channel: String
    timestamp: long
    latitude: double
    longitude: double
    ipAddress: String
end

declare AccountProfile
    accountId: String
    accountType: String
    avgMonthlySpend: double
    avgTransactionAmount: double
    primaryCountry: String
    lastKnownLatitude: double
    lastKnownLongitude: double
    lastTransactionTime: long
end

declare FraudSignal
    transactionId: String
    signalType: String
    severity: String
    score: int
    description: String
    timestamp: long
end

declare FraudAlert
    alertId: String
    transactionId: String
    accountId: String
    totalScore: int
    riskLevel: String
    action: String
    timestamp: long
end

declare HighRiskCountry
    countryCode: String
    riskLevel: String
end

// ============================================================================
// REFERENCE DATA INITIALIZATION
// ============================================================================

rule "Initialize High Risk Countries"
    salience 1000
    when
        not HighRiskCountry()
    then
        console.log("Initializing high-risk country list...");

        var highRiskCountries = ["NG", "RO", "RU", "UA", "BY", "KP", "IR", "VE"];
        for (var i = 0; i < highRiskCountries.length; i++) {
            drools.insert({
                type: "com.bank.fraud.HighRiskCountry",
                countryCode: highRiskCountries[i],
                riskLevel: "High"
            });
        }
end

// ============================================================================
// PHASE 1: AMOUNT ANOMALY DETECTION (salience 100)
// ============================================================================

rule "Signal - Large Transaction Amount"
    salience 100
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $amt: amount) from entry-point "transaction-stream"
        $profile: AccountProfile(accountId == $acct, avgTransactionAmount > 0)
        eval($amt > $profile.avgTransactionAmount * 3)
        not FraudSignal(transactionId == $id, signalType == "LARGE_AMOUNT")
    then
        var ratio = (txn.amount / profile.avgTransactionAmount).toFixed(1);
        console.log("SIGNAL: Large amount - $" + txn.amount + " is " + ratio + "x average");

        drools.insert({
            type: "com.bank.fraud.FraudSignal",
            transactionId: txn.transactionId,
            signalType: "LARGE_AMOUNT",
            severity: "Medium",
            score: 20,
            description: "Transaction " + ratio + "x larger than average",
            timestamp: txn.timestamp
        });
end

rule "Signal - Very Large Transaction"
    salience 100
    when
        $txn: Transaction($id: transactionId, amount > 5000) from entry-point "transaction-stream"
        not FraudSignal(transactionId == $id, signalType == "VERY_LARGE_AMOUNT")
    then
        console.log("SIGNAL: Very large transaction - $" + txn.amount);

        drools.insert({
            type: "com.bank.fraud.FraudSignal",
            transactionId: txn.transactionId,
            signalType: "VERY_LARGE_AMOUNT",
            severity: "High",
            score: 35,
            description: "Transaction exceeds $5,000 threshold",
            timestamp: txn.timestamp
        });
end

rule "Signal - Round Amount Suspicious"
    salience 100
    when
        $txn: Transaction($id: transactionId, $amt: amount) from entry-point "transaction-stream"
        eval($amt >= 100 && $amt == Math.floor($amt) && $amt % 100 == 0)
        not FraudSignal(transactionId == $id, signalType == "ROUND_AMOUNT")
    then
        console.log("SIGNAL: Suspicious round amount - $" + txn.amount);

        drools.insert({
            type: "com.bank.fraud.FraudSignal",
            transactionId: txn.transactionId,
            signalType: "ROUND_AMOUNT",
            severity: "Low",
            score: 15,
            description: "Large round amount often indicates card testing",
            timestamp: txn.timestamp
        });
end

rule "Signal - Just Under Reporting Threshold"
    salience 100
    when
        $txn: Transaction($id: transactionId, amount >= 9000, amount < 10000) from entry-point "transaction-stream"
        not FraudSignal(transactionId == $id, signalType == "STRUCTURING")
    then
        console.log("SIGNAL: Structuring detected - $" + txn.amount + " (just under $10k limit)");

        drools.insert({
            type: "com.bank.fraud.FraudSignal",
            transactionId: txn.transactionId,
            signalType: "STRUCTURING",
            severity: "High",
            score: 30,
            description: "Amount just below reporting threshold - possible structuring",
            timestamp: txn.timestamp
        });
end

// ============================================================================
// PHASE 2: GEOGRAPHIC ANOMALY DETECTION (salience 95)
// ============================================================================

rule "Signal - High Risk Country"
    salience 95
    when
        $txn: Transaction($id: transactionId, $country: merchantCountry) from entry-point "transaction-stream"
        HighRiskCountry(countryCode == $country)
        not FraudSignal(transactionId == $id, signalType == "HIGH_RISK_COUNTRY")
    then
        console.log("SIGNAL: High risk country - " + txn.merchantCountry);

        drools.insert({
            type: "com.bank.fraud.FraudSignal",
            transactionId: txn.transactionId,
            signalType: "HIGH_RISK_COUNTRY",
            severity: "High",
            score: 45,
            description: "Transaction from high-risk country: " + txn.merchantCountry,
            timestamp: txn.timestamp
        });
end

rule "Signal - New Country"
    salience 95
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $country: merchantCountry) from entry-point "transaction-stream"
        $profile: AccountProfile(accountId == $acct, primaryCountry != $country)
        not FraudSignal(transactionId == $id, signalType == "NEW_COUNTRY")
    then
        console.log("SIGNAL: New country detected - " + txn.merchantCountry + " (primary: " + profile.primaryCountry + ")");

        drools.insert({
            type: "com.bank.fraud.FraudSignal",
            transactionId: txn.transactionId,
            signalType: "NEW_COUNTRY",
            severity: "Medium",
            score: 25,
            description: "First transaction in " + txn.merchantCountry + " (normally " + profile.primaryCountry + ")",
            timestamp: txn.timestamp
        });
end

rule "Signal - Impossible Travel"
    salience 95
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $ts: timestamp, $lat: latitude, $lng: longitude) from entry-point "transaction-stream"
        $profile: AccountProfile(accountId == $acct, lastKnownLatitude != 0, lastTransactionTime > 0)
        eval($ts - $profile.lastTransactionTime < 3600000) // Within 1 hour
        not FraudSignal(transactionId == $id, signalType == "IMPOSSIBLE_TRAVEL")
    then
        // Calculate distance using Haversine formula
        var R = 3959; // Earth radius in miles
        var lat1 = profile.lastKnownLatitude * Math.PI / 180;
        var lat2 = txn.latitude * Math.PI / 180;
        var dLat = (txn.latitude - profile.lastKnownLatitude) * Math.PI / 180;
        var dLon = (txn.longitude - profile.lastKnownLongitude) * Math.PI / 180;
        var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLon/2) * Math.sin(dLon/2);
        var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        var distance = R * c;

        var timeHours = (txn.timestamp - profile.lastTransactionTime) / 3600000;
        var speedNeeded = distance / timeHours;

        // If speed needed > 500 mph, it's suspicious
        if (speedNeeded > 500) {
            console.log("SIGNAL: Impossible travel - " + distance.toFixed(0) + " miles in " + (timeHours * 60).toFixed(0) + " minutes");

            drools.insert({
                type: "com.bank.fraud.FraudSignal",
                transactionId: txn.transactionId,
                signalType: "IMPOSSIBLE_TRAVEL",
                severity: "Critical",
                score: 50,
                description: distance.toFixed(0) + " miles traveled in " + (timeHours * 60).toFixed(0) + " minutes (requires " + speedNeeded.toFixed(0) + " mph)",
                timestamp: txn.timestamp
            });
        }
end

// ============================================================================
// PHASE 3: VELOCITY DETECTION (salience 90)
// Uses accumulate to count transactions in time windows
// ============================================================================

rule "Signal - Rapid Fire Transactions"
    salience 90
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $ts: timestamp) from entry-point "transaction-stream"
        $count: Number(intValue > 5) from accumulate(
            Transaction(
                accountId == $acct,
                transactionId != $id,
                timestamp > ($ts - 60000),  // Last 1 minute
                timestamp < $ts
            ) from entry-point "transaction-stream",
            count(1)
        )
        not FraudSignal(transactionId == $id, signalType == "RAPID_FIRE")
    then
        console.log("SIGNAL: Rapid fire - " + count + " transactions in 1 minute");

        drools.insert({
            type: "com.bank.fraud.FraudSignal",
            transactionId: txn.transactionId,
            signalType: "RAPID_FIRE",
            severity: "High",
            score: 40,
            description: count + " transactions in the last minute",
            timestamp: txn.timestamp
        });
end

rule "Signal - High Frequency"
    salience 90
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $ts: timestamp) from entry-point "transaction-stream"
        $count: Number(intValue > 10) from accumulate(
            Transaction(
                accountId == $acct,
                transactionId != $id,
                timestamp > ($ts - 600000),  // Last 10 minutes
                timestamp < $ts
            ) from entry-point "transaction-stream",
            count(1)
        )
        not FraudSignal(transactionId == $id, signalType == "HIGH_FREQUENCY")
    then
        console.log("SIGNAL: High frequency - " + count + " transactions in 10 minutes");

        drools.insert({
            type: "com.bank.fraud.FraudSignal",
            transactionId: txn.transactionId,
            signalType: "HIGH_FREQUENCY",
            severity: "Medium",
            score: 30,
            description: count + " transactions in the last 10 minutes",
            timestamp: txn.timestamp
        });
end

rule "Signal - ATM Hammering"
    salience 90
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $ts: timestamp, channel == "atm") from entry-point "transaction-stream"
        $count: Number(intValue > 3) from accumulate(
            Transaction(
                accountId == $acct,
                transactionId != $id,
                channel == "atm",
                timestamp > ($ts - 1800000),  // Last 30 minutes
                timestamp < $ts
            ) from entry-point "transaction-stream",
            count(1)
        )
        not FraudSignal(transactionId == $id, signalType == "ATM_HAMMERING")
    then
        console.log("SIGNAL: ATM hammering - " + count + " ATM transactions in 30 minutes");

        drools.insert({
            type: "com.bank.fraud.FraudSignal",
            transactionId: txn.transactionId,
            signalType: "ATM_HAMMERING",
            severity: "High",
            score: 35,
            description: count + " ATM withdrawals in the last 30 minutes",
            timestamp: txn.timestamp
        });
end

// ============================================================================
// PHASE 4: AGGREGATE RISK SCORING (salience 80)
// ============================================================================

rule "Calculate Total Risk Score"
    salience 80
    when
        $txn: Transaction($id: transactionId, $acct: accountId, $ts: timestamp) from entry-point "transaction-stream"
        $totalScore: Number() from accumulate(
            FraudSignal(transactionId == $id, $score: score),
            sum($score)
        )
        eval($totalScore.intValue() > 0)
        not FraudAlert(transactionId == $id)
    then
        var score = totalScore.intValue();
        var riskLevel = "Low";
        var action = "allow";

        if (score > 100) {
            riskLevel = "Critical";
            action = "block_and_freeze";
        } else if (score > 75) {
            riskLevel = "Very High";
            action = "block";
        } else if (score > 50) {
            riskLevel = "High";
            action = "review";
        } else if (score > 25) {
            riskLevel = "Medium";
            action = "allow_and_log";
        }

        var alertId = "ALERT-" + txn.transactionId;

        console.log("=================================================");
        console.log("FRAUD ALERT: " + riskLevel + " (Score: " + score + ")");
        console.log("Action: " + action.toUpperCase());
        console.log("Transaction: " + txn.transactionId + " - $" + txn.amount);
        console.log("=================================================");

        drools.insert({
            type: "com.bank.fraud.FraudAlert",
            alertId: alertId,
            transactionId: txn.transactionId,
            accountId: txn.accountId,
            totalScore: score,
            riskLevel: riskLevel,
            action: action,
            timestamp: txn.timestamp
        });
end

// ============================================================================
// PHASE 5: AUTOMATED RESPONSE ACTIONS (salience 70)
// ============================================================================

rule "Action - Block Transaction"
    salience 70
    when
        $alert: FraudAlert(action == "block" || action == "block_and_freeze")
    then
        console.log("ACTION: Transaction " + alert.transactionId + " BLOCKED");
        // In production: Call transaction gateway to decline
        // gateway.declineTransaction(alert.transactionId);
end

rule "Action - Freeze Account"
    salience 70
    when
        $alert: FraudAlert(action == "block_and_freeze")
    then
        console.log("ACTION: Account " + alert.accountId + " FROZEN - Immediate investigation required");
        // In production: Call account service to freeze
        // accountService.freezeAccount(alert.accountId);
end

rule "Action - Send Review Alert"
    salience 70
    when
        $alert: FraudAlert(action == "review")
    then
        console.log("ACTION: Manual review required for transaction " + alert.transactionId);
        // In production: Queue for fraud analyst review
        // fraudQueue.addForReview(alert);
end

// ============================================================================
// QUERIES
// ============================================================================

query "ActiveAlerts"
    $alert: FraudAlert()
end

query "HighRiskAlerts"
    $alert: FraudAlert(riskLevel in ("High", "Very High", "Critical"))
end

query "BlockedTransactions"
    $alert: FraudAlert(action == "block" || action == "block_and_freeze")
end

query "SignalsByTransaction"
    $signal: FraudSignal()
end
