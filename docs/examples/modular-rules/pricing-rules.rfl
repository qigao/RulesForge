    });
end

rule "Volume Discount - Large Order"
salience 5
when
    $o : Order(itemCount >= 10)
    $p : PricingResult(orderId == $o.id)
then
    var extraDiscount = p.subtotal * 0.05;
    var newDiscount = p.discount + extraDiscount;
    console.log("Volume discount applied: " + extraDiscount);
    rfl.update(p, {
        discount: newDiscount,
        finalPrice: p.subtotal - newDiscount
    });
end

rule "Print Final Price"
salience 1
when
    $o : Order()
    $p : PricingResult(orderId == $o.id)
then
    console.log("Order " + o.id + " final price: $" + p.finalPrice + " (saved $" + p.discount + ")");
end
