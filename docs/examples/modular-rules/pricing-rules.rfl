// pricing-rules.rfl - Order pricing rules
package ecommerce.pricing

import ecommerce.common.types

rule "Calculate Base Price - Bronze Tier"
salience 10
when
    $c : Customer(tier == "Bronze")
    $o : Order(customerId == $c.id)
    $v : ValidationResult(orderId == $o.id, valid == true)
    not PricingResult(orderId == $o.id)
then
    insert PricingResult {
        orderId: $o.id,
        subtotal: $o.subtotal,
        discount: $o.subtotal * 0.05,
        finalPrice: $o.subtotal * 0.95
    }
end

rule "Calculate Base Price - Silver Tier"
salience 10
when
    $c : Customer(tier == "Silver")
    $o : Order(customerId == $c.id)
    $v : ValidationResult(orderId == $o.id, valid == true)
    not PricingResult(orderId == $o.id)
then
    insert PricingResult {
        orderId: $o.id,
        subtotal: $o.subtotal,
        discount: $o.subtotal * 0.10,
        finalPrice: $o.subtotal * 0.90
    }
end

rule "Calculate Base Price - Gold Tier"
salience 10
when
    $c : Customer(tier == "Gold")
    $o : Order(customerId == $c.id)
    $v : ValidationResult(orderId == $o.id, valid == true)
    not PricingResult(orderId == $o.id)
then
    insert PricingResult {
        orderId: $o.id,
        subtotal: $o.subtotal,
        discount: $o.subtotal * 0.15,
        finalPrice: $o.subtotal * 0.85
    }
end

rule "Calculate Base Price - Platinum Tier"
salience 10
when
    $c : Customer(tier == "Platinum")
    $o : Order(customerId == $c.id)
    $v : ValidationResult(orderId == $o.id, valid == true)
    not PricingResult(orderId == $o.id)
then
    insert PricingResult {
        orderId: $o.id,
        subtotal: $o.subtotal,
        discount: $o.subtotal * 0.20,
        finalPrice: $o.subtotal * 0.80
    }
end

rule "Volume Discount - Large Order"
salience 5
no-loop
when
    $o : Order(itemCount >= 10)
    $p : PricingResult(orderId == $o.id)
then
    update $p {
        discount: $p.discount + $p.subtotal * 0.05,
        finalPrice: $p.subtotal - ($p.discount + $p.subtotal * 0.05)
    }
end

rule "Print Final Price"
salience 1
when
    $o : Order()
    $p : PricingResult(orderId == $o.id)
then
    // Final price calculated
end
