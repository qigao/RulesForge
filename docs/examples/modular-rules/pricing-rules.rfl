rule "Calculate Base Price - Platinum Tier"
salience 10
when
    $c : Customer(tier == "Platinum")
    $o : Order(customerId == $c.id)
    $v : ValidationResult(orderId == $o.id, valid == true)
    not PricingResult(orderId == $o.id)
then
    var discount = o.subtotal * 0.20;
    console.log("Platinum tier discount: " + discount);
    rfl.insert({
        type: "ecommerce.PricingResult",
        orderId: o.id,
        subtotal: o.subtotal,
        discount: discount,
