// pricing-rules.rfl - Order pricing rules
package ecommerce.pricing

import ecommerce.common.types

rule "Calculate Base Price - Bronze Tier"
salience 10
when
    $c : Customer(tier == "Bronze")
    $o : Order(customerId == $c.id)
    $v : ValidationResult(orderId == $o.id, valid == true)
    not PricingResult(orderId == $o.id)
then
    var discount = o.subtotal * 0.05;
    console.log("Bronze tier discount: " + discount);
    rfl.insert({
        type: "ecommerce.PricingResult",
        orderId: o.id,
        subtotal: o.subtotal,
        discount: discount,
        finalPrice: o.subtotal - discount
    });
end

