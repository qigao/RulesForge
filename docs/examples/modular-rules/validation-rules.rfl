// validation-rules.rfl - Order validation rules
package ecommerce.validation

import ecommerce.common.types

rule "Validate Customer Name"
salience 100
when
    $c : Customer(name == "")
then
    insert ValidationResult {
        orderId: 0,
        valid: false,
        message: "Customer name cannot be empty"
    }
end

rule "Validate Customer Email"
salience 100
when
    $c : Customer(email == "")
then
    insert ValidationResult {
        orderId: 0,
        valid: false,
        message: "Customer email cannot be empty"
    }
end

rule "Validate Order Has Items"
salience 100
when
    $o : Order(itemCount <= 0)
then
    insert ValidationResult {
        orderId: $o.id,
        valid: false,
        message: "Order must have at least one item"
    }
end

rule "Validate Order Total"
salience 100
when
    $o : Order(subtotal <= 0)
then
    insert ValidationResult {
        orderId: $o.id,
        valid: false,
        message: "Order subtotal must be positive"
    }
end

rule "Order Valid"
salience 50
when
    $c : Customer(name != "", email != "")
    $o : Order(customerId == $c.id, itemCount > 0, subtotal > 0)
    not ValidationResult(orderId == $o.id, valid == false)
then
    insert ValidationResult {
        orderId: $o.id,
        valid: true,
        message: "Order is valid"
    }
end
