package com.bank.loan

// ============================================================================
// LOAN ELIGIBILITY RULES
// A complete loan approval system demonstrating credit scoring, risk assessment,
// and automated decision-making.
// ============================================================================

// --- Type Declarations ---

declare LoanApplication
    applicantId: String
    applicantName: String
    requestedAmount: double
    requestedTermMonths: int
    purpose: String
    creditScore: int
    annualIncome: double
    monthlyDebt: double
    employmentYears: double
    employmentType: String
    hasCollateral: boolean
    collateralValue: double
    existingCustomer: boolean
end

declare CreditCategory
    applicationId: String
    category: String
    score: int
end

declare RiskAssessment
    applicationId: String
    riskLevel: String
    debtToIncomeRatio: double
    employmentRisk: String
    collateralRisk: String
end

declare LoanDecision
    applicationId: String
    approved: boolean
    approvedAmount: double
    interestRate: double
    monthlyPayment: double
    reason: String
end

declare RejectionReason
    applicationId: String
    reason: String
    code: String
end

// ============================================================================
// PHASE 1: CREDIT CATEGORIZATION (salience 100)
// ============================================================================

rule "Credit Category - Excellent"
    salience 100
    when
        $app: LoanApplication(creditScore >= 750)
        not CreditCategory(applicationId == $app.applicantId)
    then
        insert CreditCategory {
            applicationId: $app.applicantId,
            category: "Excellent",
            score: $app.creditScore
        }
end

rule "Credit Category - Good"
    salience 100
    when
        $app: LoanApplication(creditScore >= 700, creditScore < 750)
        not CreditCategory(applicationId == $app.applicantId)
    then
        insert CreditCategory {
            applicationId: $app.applicantId,
            category: "Good",
            score: $app.creditScore
        }
end

rule "Credit Category - Fair"
    salience 100
    when
        $app: LoanApplication(creditScore >= 650, creditScore < 700)
        not CreditCategory(applicationId == $app.applicantId)
    then
        insert CreditCategory {
            applicationId: $app.applicantId,
            category: "Fair",
            score: $app.creditScore
        }
end

rule "Credit Category - Poor"
    salience 100
    when
        $app: LoanApplication(creditScore >= 550, creditScore < 650)
        not CreditCategory(applicationId == $app.applicantId)
    then
        insert CreditCategory {
            applicationId: $app.applicantId,
            category: "Poor",
            score: $app.creditScore
        }
end

rule "Credit Category - Very Poor"
    salience 100
    when
        $app: LoanApplication(creditScore < 550)
        not CreditCategory(applicationId == $app.applicantId)
    then
        insert CreditCategory {
            applicationId: $app.applicantId,
            category: "Very Poor",
            score: $app.creditScore
        }
end

// ============================================================================
// PHASE 2: RISK ASSESSMENT - Low Risk (salience 90)
// ============================================================================

rule "Risk Assessment - Low Risk"
    salience 90
    when
        $app: LoanApplication($id: applicantId, employmentType == "full-time", employmentYears >= 2)
        $credit: CreditCategory(applicationId == $id, category in ("Excellent", "Good"))
        eval($app.monthlyDebt / ($app.annualIncome / 12) * 100 < 30)
        not RiskAssessment(applicationId == $id)
    then
        insert RiskAssessment {
            applicationId: $app.applicantId,
            riskLevel: "Low",
            debtToIncomeRatio: $app.monthlyDebt / ($app.annualIncome / 12) * 100,
            employmentRisk: "Low",
            collateralRisk: "Low"
        }
end

rule "Risk Assessment - Medium Risk"
    salience 89
    when
        $app: LoanApplication($id: applicantId)
        $credit: CreditCategory(applicationId == $id, category in ("Excellent", "Good", "Fair"))
        eval($app.monthlyDebt / ($app.annualIncome / 12) * 100 >= 30)
        eval($app.monthlyDebt / ($app.annualIncome / 12) * 100 <= 43)
        not RiskAssessment(applicationId == $id)
    then
        insert RiskAssessment {
            applicationId: $app.applicantId,
            riskLevel: "Medium",
            debtToIncomeRatio: $app.monthlyDebt / ($app.annualIncome / 12) * 100,
            employmentRisk: "Medium",
            collateralRisk: "Medium"
        }
end

rule "Risk Assessment - High Risk"
    salience 88
    when
        $app: LoanApplication($id: applicantId)
        $credit: CreditCategory(applicationId == $id, category == "Poor")
        not RiskAssessment(applicationId == $id)
    then
        insert RiskAssessment {
            applicationId: $app.applicantId,
            riskLevel: "High",
            debtToIncomeRatio: $app.monthlyDebt / ($app.annualIncome / 12) * 100,
            employmentRisk: "High",
            collateralRisk: "High"
        }
end

rule "Risk Assessment - Very High Risk"
    salience 87
    when
        $app: LoanApplication($id: applicantId)
        $credit: CreditCategory(applicationId == $id, category == "Very Poor")
        not RiskAssessment(applicationId == $id)
    then
        insert RiskAssessment {
            applicationId: $app.applicantId,
            riskLevel: "Very High",
            debtToIncomeRatio: $app.monthlyDebt / ($app.annualIncome / 12) * 100,
            employmentRisk: "High",
            collateralRisk: "High"
        }
end

rule "Risk Assessment - High DTI"
    salience 86
    when
        $app: LoanApplication($id: applicantId)
        $credit: CreditCategory(applicationId == $id)
        eval($app.monthlyDebt / ($app.annualIncome / 12) * 100 > 43)
        not RiskAssessment(applicationId == $id)
    then
        insert RiskAssessment {
            applicationId: $app.applicantId,
            riskLevel: "High",
            debtToIncomeRatio: $app.monthlyDebt / ($app.annualIncome / 12) * 100,
            employmentRisk: "Medium",
            collateralRisk: "Medium"
        }
end

// ============================================================================
// PHASE 3: AUTOMATIC REJECTIONS (salience 85)
// ============================================================================

rule "Reject - Credit Score Too Low"
    salience 85
    when
        $app: LoanApplication($id: applicantId, creditScore < 500)
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        insert RejectionReason {
            applicationId: $app.applicantId,
            reason: "Credit score below minimum threshold of 500",
            code: "CREDIT_TOO_LOW"
        }
end

rule "Reject - DTI Too High"
    salience 85
    when
        $app: LoanApplication($id: applicantId)
        $risk: RiskAssessment(applicationId == $id, debtToIncomeRatio > 50)
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        insert RejectionReason {
            applicationId: $app.applicantId,
            reason: "Debt-to-income ratio exceeds maximum of 50%",
            code: "DTI_TOO_HIGH"
        }
end

rule "Reject - Unemployed Without Collateral"
    salience 85
    when
        $app: LoanApplication($id: applicantId, employmentType == "unemployed", hasCollateral == false)
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        insert RejectionReason {
            applicationId: $app.applicantId,
            reason: "Unemployed applicants require collateral",
            code: "NO_INCOME_NO_COLLATERAL"
        }
end

rule "Reject - Insufficient Income"
    salience 85
    when
        $app: LoanApplication($id: applicantId, annualIncome < 20000)
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        insert RejectionReason {
            applicationId: $app.applicantId,
            reason: "Annual income below minimum threshold of $20,000",
            code: "INCOME_TOO_LOW"
        }
end

// ============================================================================
// PHASE 4: CREATE REJECTION DECISION (salience 80)
// ============================================================================

rule "Create Rejection Decision"
    salience 80
    when
        $app: LoanApplication($id: applicantId)
        $rejection: RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        insert LoanDecision {
            applicationId: $app.applicantId,
            approved: false,
            approvedAmount: 0,
            interestRate: 0,
            monthlyPayment: 0,
            reason: $rejection.reason
        }
end

// ============================================================================
// PHASE 5: LOAN APPROVAL DECISIONS (salience 70)
// ============================================================================

rule "Approve - Low Risk Application"
    salience 70
    when
        $app: LoanApplication($id: applicantId, existingCustomer == true)
        $credit: CreditCategory(applicationId == $id, category == "Excellent")
        $risk: RiskAssessment(applicationId == $id, riskLevel == "Low")
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        insert LoanDecision {
            applicationId: $app.applicantId,
            approved: true,
            approvedAmount: $app.requestedAmount,
            interestRate: 4.6,
            monthlyPayment: $app.requestedAmount * 0.02,
            reason: "Low risk application approved - Excellent credit, existing customer"
        }
end

rule "Approve - Low Risk New Customer"
    salience 70
    when
        $app: LoanApplication($id: applicantId, existingCustomer == false)
        $credit: CreditCategory(applicationId == $id, category == "Excellent")
        $risk: RiskAssessment(applicationId == $id, riskLevel == "Low")
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        insert LoanDecision {
            applicationId: $app.applicantId,
            approved: true,
            approvedAmount: $app.requestedAmount,
            interestRate: 5.0,
            monthlyPayment: $app.requestedAmount * 0.021,
            reason: "Low risk application approved"
        }
end

rule "Approve - Low Risk Good Credit"
    salience 69
    when
        $app: LoanApplication($id: applicantId)
        $credit: CreditCategory(applicationId == $id, category == "Good")
        $risk: RiskAssessment(applicationId == $id, riskLevel == "Low")
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        insert LoanDecision {
            applicationId: $app.applicantId,
            approved: true,
            approvedAmount: $app.requestedAmount,
            interestRate: 5.5,
            monthlyPayment: $app.requestedAmount * 0.022,
            reason: "Low risk application approved - Good credit"
        }
end

rule "Approve - Medium Risk Application"
    salience 68
    when
        $app: LoanApplication($id: applicantId)
        $credit: CreditCategory(applicationId == $id, category in ("Excellent", "Good", "Fair"))
        $risk: RiskAssessment(applicationId == $id, riskLevel == "Medium")
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        insert LoanDecision {
            applicationId: $app.applicantId,
            approved: true,
            approvedAmount: $app.requestedAmount,
            interestRate: 7.5,
            monthlyPayment: $app.requestedAmount * 0.025,
            reason: "Medium risk application approved with standard terms"
        }
end

rule "Approve - High Risk With Collateral"
    salience 67
    when
        $app: LoanApplication($id: applicantId, hasCollateral == true)
        $credit: CreditCategory(applicationId == $id)
        $risk: RiskAssessment(applicationId == $id, riskLevel == "High")
        eval($app.requestedAmount <= $app.collateralValue * 0.8)
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        insert LoanDecision {
            applicationId: $app.applicantId,
            approved: true,
            approvedAmount: $app.requestedAmount * 0.8,
            interestRate: 10.5,
            monthlyPayment: $app.requestedAmount * 0.8 * 0.03,
            reason: "High risk application approved with reduced amount (secured by collateral)"
        }
end

rule "Reject - High Risk Without Collateral"
    salience 66
    when
        $app: LoanApplication($id: applicantId, hasCollateral == false)
        $risk: RiskAssessment(applicationId == $id, riskLevel in ("High", "Very High"))
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        insert LoanDecision {
            applicationId: $app.applicantId,
            approved: false,
            approvedAmount: 0,
            interestRate: 0,
            monthlyPayment: 0,
            reason: "High risk applications require collateral"
        }
end

rule "Reject - Very High Risk"
    salience 65
    when
        $app: LoanApplication($id: applicantId)
        $risk: RiskAssessment(applicationId == $id, riskLevel == "Very High")
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        insert LoanDecision {
            applicationId: $app.applicantId,
            approved: false,
            approvedAmount: 0,
            interestRate: 0,
            monthlyPayment: 0,
            reason: "Application exceeds acceptable risk threshold"
        }
end

// ============================================================================
// QUERIES
// ============================================================================

query "LoanDecisions"
    $decision: LoanDecision()
end

query "ApprovedLoans"
    $decision: LoanDecision(approved == true)
end

query "RejectedLoans"
    $decision: LoanDecision(approved == false)
end

query "HighRiskApplications"
    $risk: RiskAssessment(riskLevel in ("High", "Very High"))
end
