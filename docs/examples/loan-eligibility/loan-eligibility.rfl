package com.bank.loan

// ============================================================================
// LOAN ELIGIBILITY RULES
// A complete loan approval system demonstrating credit scoring, risk assessment,
// and automated decision-making.
// ============================================================================

// --- Type Declarations ---

declare LoanApplication
    applicantId: String
    applicantName: String
    requestedAmount: double
    requestedTermMonths: int
    purpose: String
    creditScore: int
    annualIncome: double
    monthlyDebt: double
    employmentYears: double
    employmentType: String
    hasCollateral: boolean
    collateralValue: double
    existingCustomer: boolean
end

declare CreditCategory
    applicationId: String
    category: String
    score: int
end

declare RiskAssessment
    applicationId: String
    riskLevel: String
    debtToIncomeRatio: double
    employmentRisk: String
    collateralRisk: String
end

declare LoanDecision
    applicationId: String
    approved: boolean
    approvedAmount: double
    interestRate: double
    monthlyPayment: double
    reason: String
end

declare RejectionReason
    applicationId: String
    reason: String
    code: String
end

// ============================================================================
// PHASE 1: CREDIT CATEGORIZATION (salience 100)
// ============================================================================

rule "Credit Category - Excellent"
    salience 100
    when
        $app: LoanApplication(creditScore >= 750)
        not CreditCategory(applicationId == $app.applicantId)
    then
        console.log("Credit Assessment: " + app.applicantName + " - EXCELLENT (" + app.creditScore + ")");
        rfl.insert({
            type: "com.bank.loan.CreditCategory",
            applicationId: app.applicantId,
            category: "Excellent",
            score: app.creditScore
        });
end

rule "Credit Category - Good"
    salience 100
    when
        $app: LoanApplication(creditScore >= 700, creditScore < 750)
        not CreditCategory(applicationId == $app.applicantId)
    then
        console.log("Credit Assessment: " + app.applicantName + " - GOOD (" + app.creditScore + ")");
        rfl.insert({
            type: "com.bank.loan.CreditCategory",
            applicationId: app.applicantId,
            category: "Good",
            score: app.creditScore
        });
end

rule "Credit Category - Fair"
    salience 100
    when
        $app: LoanApplication(creditScore >= 650, creditScore < 700)
        not CreditCategory(applicationId == $app.applicantId)
    then
        console.log("Credit Assessment: " + app.applicantName + " - FAIR (" + app.creditScore + ")");
        rfl.insert({
            type: "com.bank.loan.CreditCategory",
            applicationId: app.applicantId,
            category: "Fair",
            score: app.creditScore
        });
end

rule "Credit Category - Poor"
    salience 100
    when
        $app: LoanApplication(creditScore >= 550, creditScore < 650)
        not CreditCategory(applicationId == $app.applicantId)
    then
        console.log("Credit Assessment: " + app.applicantName + " - POOR (" + app.creditScore + ")");
        rfl.insert({
            type: "com.bank.loan.CreditCategory",
            applicationId: app.applicantId,
            category: "Poor",
            score: app.creditScore
        });
end

rule "Credit Category - Very Poor"
    salience 100
    when
        $app: LoanApplication(creditScore < 550)
        not CreditCategory(applicationId == $app.applicantId)
    then
        console.log("Credit Assessment: " + app.applicantName + " - VERY POOR (" + app.creditScore + ")");
        rfl.insert({
            type: "com.bank.loan.CreditCategory",
            applicationId: app.applicantId,
            category: "Very Poor",
            score: app.creditScore
        });
end

// ============================================================================
// PHASE 2: RISK ASSESSMENT (salience 90)
// ============================================================================

rule "Calculate Risk Assessment"
    salience 90
    when
        $app: LoanApplication($id: applicantId)
        $credit: CreditCategory(applicationId == $id)
        not RiskAssessment(applicationId == $id)
    then
        var monthlyIncome = app.annualIncome / 12;
        var dti = (app.monthlyDebt / monthlyIncome) * 100;

        // Determine employment risk
        var empRisk = "High";
        if (app.employmentType == "full-time" && app.employmentYears >= 2) {
            empRisk = "Low";
        } else if (app.employmentType == "full-time" || app.employmentYears >= 1) {
            empRisk = "Medium";
        }

        // Determine collateral risk
        var collRisk = "High";
        if (app.hasCollateral) {
            var ltv = (app.requestedAmount / app.collateralValue) * 100;
            if (ltv <= 80) {
                collRisk = "Low";
            } else if (ltv <= 95) {
                collRisk = "Medium";
            }
        }

        // Determine overall risk level
        var riskLevel = "Medium";
        if (credit.category == "Excellent" && dti < 30 && empRisk == "Low") {
            riskLevel = "Low";
        } else if (credit.category == "Very Poor" || dti > 50 || empRisk == "High") {
            riskLevel = "Very High";
        } else if (credit.category == "Poor" || dti > 43) {
            riskLevel = "High";
        }

        console.log("Risk Assessment: " + app.applicantName + " - " + riskLevel + " (DTI: " + dti.toFixed(1) + "%)");

        rfl.insert({
            type: "com.bank.loan.RiskAssessment",
            applicationId: app.applicantId,
            riskLevel: riskLevel,
            debtToIncomeRatio: dti,
            employmentRisk: empRisk,
            collateralRisk: collRisk
        });
end

// ============================================================================
// PHASE 3: AUTOMATIC REJECTIONS (salience 85)
// ============================================================================

rule "Reject - Credit Score Too Low"
    salience 85
    when
        $app: LoanApplication($id: applicantId, creditScore < 500)
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        console.log("AUTO-REJECT: " + app.applicantName + " - Credit score below minimum (500)");
        rfl.insert({
            type: "com.bank.loan.RejectionReason",
            applicationId: app.applicantId,
            reason: "Credit score below minimum threshold of 500",
            code: "CREDIT_TOO_LOW"
        });
end

rule "Reject - DTI Too High"
    salience 85
    when
        $app: LoanApplication($id: applicantId)
        $risk: RiskAssessment(applicationId == $id, debtToIncomeRatio > 50)
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        console.log("AUTO-REJECT: " + app.applicantName + " - DTI exceeds 50%");
        rfl.insert({
            type: "com.bank.loan.RejectionReason",
            applicationId: app.applicantId,
            reason: "Debt-to-income ratio exceeds maximum of 50%",
            code: "DTI_TOO_HIGH"
        });
end

rule "Reject - Unemployed Without Collateral"
    salience 85
    when
        $app: LoanApplication($id: applicantId, employmentType == "unemployed", hasCollateral == false)
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        console.log("AUTO-REJECT: " + app.applicantName + " - Unemployed without collateral");
        rfl.insert({
            type: "com.bank.loan.RejectionReason",
            applicationId: app.applicantId,
            reason: "Unemployed applicants require collateral",
            code: "NO_INCOME_NO_COLLATERAL"
        });
end

rule "Reject - Insufficient Income"
    salience 85
    when
        $app: LoanApplication($id: applicantId, annualIncome < 20000)
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        console.log("AUTO-REJECT: " + app.applicantName + " - Annual income below $20,000");
        rfl.insert({
            type: "com.bank.loan.RejectionReason",
            applicationId: app.applicantId,
            reason: "Annual income below minimum threshold of $20,000",
            code: "INCOME_TOO_LOW"
        });
end

// ============================================================================
// PHASE 4: CREATE REJECTION DECISION (salience 80)
// ============================================================================

rule "Create Rejection Decision"
    salience 80
    when
        $app: LoanApplication($id: applicantId)
        $rejection: RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        console.log("DECISION: " + app.applicantName + " - REJECTED (" + rejection.reason + ")");
        rfl.insert({
            type: "com.bank.loan.LoanDecision",
            applicationId: app.applicantId,
            approved: false,
            approvedAmount: 0,
            interestRate: 0,
            monthlyPayment: 0,
            reason: rejection.reason
        });
end

// ============================================================================
// PHASE 5: LOAN APPROVAL DECISIONS (salience 70)
// ============================================================================

rule "Approve - Low Risk Application"
    salience 70
    when
        $app: LoanApplication($id: applicantId)
        $credit: CreditCategory(applicationId == $id, category in ("Excellent", "Good"))
        $risk: RiskAssessment(applicationId == $id, riskLevel == "Low")
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        // Base rate for low risk
        var baseRate = 5.5;

        // Credit score adjustment
        if (credit.category == "Excellent") {
            baseRate = baseRate - 0.5;
        }

        // Existing customer discount
        if (app.existingCustomer) {
            baseRate = baseRate - 0.15;
        }

        // Collateral adjustment
        if (app.hasCollateral && app.collateralValue >= app.requestedAmount * 1.2) {
            baseRate = baseRate - 0.25;
        }

        // Calculate monthly payment
        var monthlyRate = baseRate / 100 / 12;
        var numPayments = app.requestedTermMonths;
        var monthlyPayment = app.requestedAmount * (monthlyRate * Math.pow(1 + monthlyRate, numPayments)) /
                            (Math.pow(1 + monthlyRate, numPayments) - 1);

        console.log("DECISION: " + app.applicantName + " - APPROVED at " + baseRate.toFixed(2) + "% APR");

        rfl.insert({
            type: "com.bank.loan.LoanDecision",
            applicationId: app.applicantId,
            approved: true,
            approvedAmount: app.requestedAmount,
            interestRate: baseRate,
            monthlyPayment: monthlyPayment,
            reason: "Low risk application approved"
        });
end

rule "Approve - Medium Risk Application"
    salience 70
    when
        $app: LoanApplication($id: applicantId)
        $credit: CreditCategory(applicationId == $id, category in ("Excellent", "Good", "Fair"))
        $risk: RiskAssessment(applicationId == $id, riskLevel == "Medium")
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        // Base rate for medium risk
        var baseRate = 7.5;

        // Credit score adjustment
        if (credit.category == "Excellent") {
            baseRate = baseRate - 0.75;
        } else if (credit.category == "Good") {
            baseRate = baseRate - 0.5;
        }

        // Existing customer discount
        if (app.existingCustomer) {
            baseRate = baseRate - 0.10;
        }

        // Collateral adjustment
        if (app.hasCollateral) {
            baseRate = baseRate - 0.25;
        }

        // Calculate monthly payment
        var monthlyRate = baseRate / 100 / 12;
        var numPayments = app.requestedTermMonths;
        var monthlyPayment = app.requestedAmount * (monthlyRate * Math.pow(1 + monthlyRate, numPayments)) /
                            (Math.pow(1 + monthlyRate, numPayments) - 1);

        console.log("DECISION: " + app.applicantName + " - APPROVED at " + baseRate.toFixed(2) + "% APR");

        rfl.insert({
            type: "com.bank.loan.LoanDecision",
            applicationId: app.applicantId,
            approved: true,
            approvedAmount: app.requestedAmount,
            interestRate: baseRate,
            monthlyPayment: monthlyPayment,
            reason: "Medium risk application approved with standard terms"
        });
end

rule "Approve - High Risk With Collateral"
    salience 70
    when
        $app: LoanApplication($id: applicantId, hasCollateral == true)
        $credit: CreditCategory(applicationId == $id)
        $risk: RiskAssessment(applicationId == $id, riskLevel == "High", collateralRisk in ("Low", "Medium"))
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        // Base rate for high risk secured
        var baseRate = 10.5;

        // Reduce amount to 80% of requested if high risk
        var approvedAmount = app.requestedAmount * 0.8;

        // Calculate monthly payment
        var monthlyRate = baseRate / 100 / 12;
        var numPayments = app.requestedTermMonths;
        var monthlyPayment = approvedAmount * (monthlyRate * Math.pow(1 + monthlyRate, numPayments)) /
                            (Math.pow(1 + monthlyRate, numPayments) - 1);

        console.log("DECISION: " + app.applicantName + " - APPROVED (reduced) at " + baseRate.toFixed(2) + "% APR");

        rfl.insert({
            type: "com.bank.loan.LoanDecision",
            applicationId: app.applicantId,
            approved: true,
            approvedAmount: approvedAmount,
            interestRate: baseRate,
            monthlyPayment: monthlyPayment,
            reason: "High risk application approved with reduced amount (secured by collateral)"
        });
end

rule "Reject - High Risk Without Collateral"
    salience 70
    when
        $app: LoanApplication($id: applicantId, hasCollateral == false)
        $risk: RiskAssessment(applicationId == $id, riskLevel in ("High", "Very High"))
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        console.log("DECISION: " + app.applicantName + " - REJECTED (high risk, no collateral)");
        rfl.insert({
            type: "com.bank.loan.LoanDecision",
            applicationId: app.applicantId,
            approved: false,
            approvedAmount: 0,
            interestRate: 0,
            monthlyPayment: 0,
            reason: "High risk applications require collateral"
        });
end

rule "Reject - Very High Risk"
    salience 70
    when
        $app: LoanApplication($id: applicantId)
        $risk: RiskAssessment(applicationId == $id, riskLevel == "Very High")
        not RejectionReason(applicationId == $id)
        not LoanDecision(applicationId == $id)
    then
        console.log("DECISION: " + app.applicantName + " - REJECTED (very high risk)");
        rfl.insert({
            type: "com.bank.loan.LoanDecision",
            applicationId: app.applicantId,
            approved: false,
            approvedAmount: 0,
            interestRate: 0,
            monthlyPayment: 0,
            reason: "Application exceeds acceptable risk threshold"
        });
end

// ============================================================================
// QUERIES
// ============================================================================

query "LoanDecisions"
    $decision: LoanDecision()
end

query "ApprovedLoans"
    $decision: LoanDecision(approved == true)
end

query "RejectedLoans"
    $decision: LoanDecision(approved == false)
end

query "HighRiskApplications"
    $risk: RiskAssessment(riskLevel in ("High", "Very High"))
end
