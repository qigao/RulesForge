package com.travel

// ============================================================================
// TRAVEL BOOKING RULES
// Multi-service travel agency with flights, hotels, visas, and packages.
// ============================================================================

// --- Type Declarations ---

declare TravelRequest
    requestId: String
    customerId: String
    loyaltyTier: String
    loyaltyPoints: int
    origin: String
    destination: String
    departureDate: long
    returnDate: long
    travelers: int
    cabinClass: String
    hotelStars: int
    includeInsurance: boolean
    nationality: String
end

declare FlightOption
    flightId: String
    airline: String
    origin: String
    destination: String
    departureTime: long
    cabinClass: String
    basePrice: double
    seatsAvailable: int
end

declare HotelOption
    hotelId: String
    name: String
    destinationCity: String
    stars: int
    pricePerNight: double
    availableRooms: int
end

declare VisaRequirement
    nationality: String
    destinationCountry: String
    required: boolean
    visaType: String
    processingDays: int
    cost: double
end

declare FlightQuote
    requestId: String
    flightId: String
    basePrice: double
    seasonalAdjustment: double
    loyaltyDiscount: double
    totalPerPerson: double
    totalAllTravelers: double
    pointsEarned: int
end

declare HotelQuote
    requestId: String
    hotelId: String
    nights: int
    pricePerNight: double
    subtotal: double
    loyaltyDiscount: double
    packageDiscount: double
    totalPrice: double
    pointsEarned: int
end

declare InsuranceQuote
    requestId: String
    pricePerPerson: double
    totalPrice: double
    coverageLevel: String
end

declare VisaAlert
    requestId: String
    required: boolean
    visaType: String
    processingDays: int
    cost: double
    message: String
end

declare PackageQuote
    requestId: String
    flightTotal: double
    hotelTotal: double
    insuranceTotal: double
    visaCost: double
    pointsRedemption: double
    grandTotal: double
    totalPointsEarned: int
end

declare BookingIssue
    requestId: String
    issueType: String
    message: String
    blocking: boolean
end

// ============================================================================
// PHASE 1: FLIGHT PRICING (salience 100)
// ============================================================================

rule "Flight Quote - Platinum Member"
    salience 100
    when
        $req: TravelRequest($reqId: requestId, $origin: origin, $dest: destination, $class: cabinClass, $travelers: travelers, loyaltyTier == "platinum")
        $flight: FlightOption(origin == $origin, destination == $dest, cabinClass == $class, seatsAvailable >= $travelers)
        not FlightQuote(requestId == $reqId, flightId == $flight.flightId)
    then
        insert FlightQuote {
            requestId: $req.requestId,
            flightId: $flight.flightId,
            basePrice: $flight.basePrice,
            seasonalAdjustment: 0.0,
            loyaltyDiscount: $flight.basePrice * 0.15,
            totalPerPerson: $flight.basePrice * 0.85,
            totalAllTravelers: $flight.basePrice * 0.85 * $req.travelers,
            pointsEarned: floor($flight.basePrice * 0.85 * $req.travelers * 3)
        }
end

rule "Flight Quote - Gold Member"
    salience 99
    when
        $req: TravelRequest($reqId: requestId, $origin: origin, $dest: destination, $class: cabinClass, $travelers: travelers, loyaltyTier == "gold")
        $flight: FlightOption(origin == $origin, destination == $dest, cabinClass == $class, seatsAvailable >= $travelers)
        not FlightQuote(requestId == $reqId, flightId == $flight.flightId)
    then
        insert FlightQuote {
            requestId: $req.requestId,
            flightId: $flight.flightId,
            basePrice: $flight.basePrice,
            seasonalAdjustment: 0.0,
            loyaltyDiscount: $flight.basePrice * 0.10,
            totalPerPerson: $flight.basePrice * 0.90,
            totalAllTravelers: $flight.basePrice * 0.90 * $req.travelers,
            pointsEarned: floor($flight.basePrice * 0.90 * $req.travelers * 2)
        }
end

rule "Flight Quote - Silver Member"
    salience 98
    when
        $req: TravelRequest($reqId: requestId, $origin: origin, $dest: destination, $class: cabinClass, $travelers: travelers, loyaltyTier == "silver")
        $flight: FlightOption(origin == $origin, destination == $dest, cabinClass == $class, seatsAvailable >= $travelers)
        not FlightQuote(requestId == $reqId, flightId == $flight.flightId)
    then
        insert FlightQuote {
            requestId: $req.requestId,
            flightId: $flight.flightId,
            basePrice: $flight.basePrice,
            seasonalAdjustment: 0.0,
            loyaltyDiscount: $flight.basePrice * 0.05,
            totalPerPerson: $flight.basePrice * 0.95,
            totalAllTravelers: $flight.basePrice * 0.95 * $req.travelers,
            pointsEarned: floor($flight.basePrice * 0.95 * $req.travelers * 1.5)
        }
end

rule "Flight Quote - Standard Member"
    salience 97
    when
        $req: TravelRequest($reqId: requestId, $origin: origin, $dest: destination, $class: cabinClass, $travelers: travelers)
        $flight: FlightOption(origin == $origin, destination == $dest, cabinClass == $class, seatsAvailable >= $travelers)
        not FlightQuote(requestId == $reqId, flightId == $flight.flightId)
    then
        insert FlightQuote {
            requestId: $req.requestId,
            flightId: $flight.flightId,
            basePrice: $flight.basePrice,
            seasonalAdjustment: 0.0,
            loyaltyDiscount: 0.0,
            totalPerPerson: $flight.basePrice,
            totalAllTravelers: $flight.basePrice * $req.travelers,
            pointsEarned: floor($flight.basePrice * $req.travelers)
        }
end

rule "Flight Issue - No Seats Available"
    salience 100
    when
        $req: TravelRequest($reqId: requestId, $origin: origin, $dest: destination, $class: cabinClass, $travelers: travelers)
        not FlightOption(origin == $origin, destination == $dest, cabinClass == $class, seatsAvailable >= $travelers)
        not BookingIssue(requestId == $reqId, issueType == "NO_FLIGHTS")
    then
        insert BookingIssue {
            requestId: $req.requestId,
            issueType: "NO_FLIGHTS",
            message: "No flights available with sufficient seats",
            blocking: true
        }
end

// ============================================================================
// PHASE 2: HOTEL PRICING (salience 90)
// ============================================================================

rule "Hotel Quote - Platinum Member"
    salience 90
    when
        $req: TravelRequest($reqId: requestId, $dest: destination, $stars: hotelStars, loyaltyTier == "platinum", $depDate: departureDate, $retDate: returnDate)
        $hotel: HotelOption(destinationCity == $dest, stars >= $stars, availableRooms > 0)
        FlightQuote(requestId == $reqId)
        not HotelQuote(requestId == $reqId, hotelId == $hotel.hotelId)
    then
        insert HotelQuote {
            requestId: $req.requestId,
            hotelId: $hotel.hotelId,
            nights: 5,
            pricePerNight: $hotel.pricePerNight,
            subtotal: $hotel.pricePerNight * 5,
            loyaltyDiscount: $hotel.pricePerNight * 5 * 0.15,
            packageDiscount: $hotel.pricePerNight * 5 * 0.10,
            totalPrice: $hotel.pricePerNight * 5 * 0.75,
            pointsEarned: floor($hotel.pricePerNight * 5 * 0.75 * 3)
        }
end

rule "Hotel Quote - Gold Member"
    salience 89
    when
        $req: TravelRequest($reqId: requestId, $dest: destination, $stars: hotelStars, loyaltyTier == "gold", $depDate: departureDate, $retDate: returnDate)
        $hotel: HotelOption(destinationCity == $dest, stars >= $stars, availableRooms > 0)
        FlightQuote(requestId == $reqId)
        not HotelQuote(requestId == $reqId, hotelId == $hotel.hotelId)
    then
        insert HotelQuote {
            requestId: $req.requestId,
            hotelId: $hotel.hotelId,
            nights: 5,
            pricePerNight: $hotel.pricePerNight,
            subtotal: $hotel.pricePerNight * 5,
            loyaltyDiscount: $hotel.pricePerNight * 5 * 0.10,
            packageDiscount: $hotel.pricePerNight * 5 * 0.10,
            totalPrice: $hotel.pricePerNight * 5 * 0.80,
            pointsEarned: floor($hotel.pricePerNight * 5 * 0.80 * 2)
        }
end

rule "Hotel Quote - Standard Member"
    salience 85
    when
        $req: TravelRequest($reqId: requestId, $dest: destination, $stars: hotelStars, $depDate: departureDate, $retDate: returnDate)
        $hotel: HotelOption(destinationCity == $dest, stars >= $stars, availableRooms > 0)
        FlightQuote(requestId == $reqId)
        not HotelQuote(requestId == $reqId, hotelId == $hotel.hotelId)
    then
        insert HotelQuote {
            requestId: $req.requestId,
            hotelId: $hotel.hotelId,
            nights: 5,
            pricePerNight: $hotel.pricePerNight,
            subtotal: $hotel.pricePerNight * 5,
            loyaltyDiscount: 0.0,
            packageDiscount: $hotel.pricePerNight * 5 * 0.10,
            totalPrice: $hotel.pricePerNight * 5 * 0.90,
            pointsEarned: floor($hotel.pricePerNight * 5 * 0.90)
        }
end

// ============================================================================
// PHASE 3: VISA CHECK (salience 85)
// ============================================================================

rule "Visa Check - Required"
    salience 85
    when
        $req: TravelRequest($reqId: requestId, $nat: nationality, $dest: destination)
        $visa: VisaRequirement(nationality == $nat, destinationCountry == $dest, required == true)
        not VisaAlert(requestId == $reqId)
    then
        insert VisaAlert {
            requestId: $req.requestId,
            required: true,
            visaType: $visa.visaType,
            processingDays: $visa.processingDays,
            cost: $visa.cost,
            message: $visa.visaType + " visa required - " + $visa.processingDays + " days processing"
        }
end

rule "Visa Check - Not Required"
    salience 85
    when
        $req: TravelRequest($reqId: requestId, $nat: nationality, $dest: destination)
        $visa: VisaRequirement(nationality == $nat, destinationCountry == $dest, required == false)
        not VisaAlert(requestId == $reqId)
    then
        insert VisaAlert {
            requestId: $req.requestId,
            required: false,
            visaType: "none",
            processingDays: 0,
            cost: 0,
            message: "No visa required for this destination"
        }
end

rule "Visa Check - No Data"
    salience 80
    when
        $req: TravelRequest($reqId: requestId, $nat: nationality, $dest: destination)
        not VisaRequirement(nationality == $nat, destinationCountry == $dest)
        not VisaAlert(requestId == $reqId)
    then
        insert VisaAlert {
            requestId: $req.requestId,
            required: false,
            visaType: "unknown",
            processingDays: 0,
            cost: 0,
            message: "Visa requirements unknown - please verify"
        }
end

// ============================================================================
// PHASE 4: INSURANCE PRICING (salience 80)
// ============================================================================

rule "Insurance Quote - Standard"
    salience 80
    when
        $req: TravelRequest($reqId: requestId, $travelers: travelers, includeInsurance == true)
        FlightQuote(requestId == $reqId)
        not InsuranceQuote(requestId == $reqId)
    then
        insert InsuranceQuote {
            requestId: $req.requestId,
            pricePerPerson: 39.0,
            totalPrice: 39.0 * $req.travelers,
            coverageLevel: "Standard"
        }
end

rule "Insurance Quote - Declined"
    salience 80
    when
        $req: TravelRequest($reqId: requestId, includeInsurance == false)
        FlightQuote(requestId == $reqId)
        not InsuranceQuote(requestId == $reqId)
    then
        insert InsuranceQuote {
            requestId: $req.requestId,
            pricePerPerson: 0,
            totalPrice: 0,
            coverageLevel: "None"
        }
end

// ============================================================================
// PHASE 5: PACKAGE QUOTE (salience 70)
// ============================================================================

rule "Create Package Quote - With Points Redemption"
    salience 70
    when
        $req: TravelRequest($reqId: requestId, loyaltyPoints >= 10000)
        $flight: FlightQuote(requestId == $reqId, $flightTotal: totalAllTravelers, $flightPoints: pointsEarned)
        $hotel: HotelQuote(requestId == $reqId, $hotelTotal: totalPrice, $hotelPoints: pointsEarned)
        $insurance: InsuranceQuote(requestId == $reqId, $insuranceTotal: totalPrice)
        $visa: VisaAlert(requestId == $reqId, $visaCost: cost)
        not PackageQuote(requestId == $reqId)
    then
        insert PackageQuote {
            requestId: $req.requestId,
            flightTotal: $flight.totalAllTravelers,
            hotelTotal: $hotel.totalPrice,
            insuranceTotal: $insurance.totalPrice,
            visaCost: $visa.cost,
            pointsRedemption: min(floor($req.loyaltyPoints / 10000) * 100, 500),
            grandTotal: $flight.totalAllTravelers + $hotel.totalPrice + $insurance.totalPrice + $visa.cost - min(floor($req.loyaltyPoints / 10000) * 100, 500),
            totalPointsEarned: $flight.pointsEarned + $hotel.pointsEarned
        }
end

rule "Create Package Quote - No Points Redemption"
    salience 69
    when
        $req: TravelRequest($reqId: requestId, loyaltyPoints < 10000)
        $flight: FlightQuote(requestId == $reqId, $flightTotal: totalAllTravelers, $flightPoints: pointsEarned)
        $hotel: HotelQuote(requestId == $reqId, $hotelTotal: totalPrice, $hotelPoints: pointsEarned)
        $insurance: InsuranceQuote(requestId == $reqId, $insuranceTotal: totalPrice)
        $visa: VisaAlert(requestId == $reqId, $visaCost: cost)
        not PackageQuote(requestId == $reqId)
    then
        insert PackageQuote {
            requestId: $req.requestId,
            flightTotal: $flight.totalAllTravelers,
            hotelTotal: $hotel.totalPrice,
            insuranceTotal: $insurance.totalPrice,
            visaCost: $visa.cost,
            pointsRedemption: 0,
            grandTotal: $flight.totalAllTravelers + $hotel.totalPrice + $insurance.totalPrice + $visa.cost,
            totalPointsEarned: $flight.pointsEarned + $hotel.pointsEarned
        }
end

// ============================================================================
// PHASE 6: BOOKING ISSUES (salience 60)
// ============================================================================

rule "Issue - Visa Processing Time Warning"
    salience 60
    when
        $req: TravelRequest($reqId: requestId, $depDate: departureDate)
        $visa: VisaAlert(requestId == $reqId, required == true, processingDays > 5)
        not BookingIssue(requestId == $reqId, issueType == "VISA_TIME")
    then
        insert BookingIssue {
            requestId: $req.requestId,
            issueType: "VISA_TIME",
            message: "Visa processing takes " + $visa.processingDays + " days - plan accordingly",
            blocking: false
        }
end

rule "Issue - Insufficient Points for Redemption"
    salience 60
    when
        $req: TravelRequest($reqId: requestId, loyaltyPoints < 10000, loyaltyPoints > 0)
        not BookingIssue(requestId == $reqId, issueType == "LOW_POINTS")
    then
        insert BookingIssue {
            requestId: $req.requestId,
            issueType: "LOW_POINTS",
            message: "Earn more points to redeem for $100 credit",
            blocking: false
        }
end

// ============================================================================
// QUERIES
// ============================================================================

query "FlightQuotes"
    $quote: FlightQuote()
end

query "HotelQuotes"
    $quote: HotelQuote()
end

query "PackageQuotes"
    $quote: PackageQuote()
end

query "BookingIssues"
    $issue: BookingIssue()
end

query "VisaAlerts"
    $alert: VisaAlert()
end

query "BlockingIssues"
    $issue: BookingIssue(blocking == true)
end
