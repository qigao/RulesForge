package com.picimpact.dispatch.pricing

//
// Runtime input:
//   QuantityInput { quantity }
//
// Runtime output:
//   Two CurrencyPriceResult rows: one for CNY and one for USD.
//
// Intended execution model:
//   sessionless/low-frequency calculation. Create a fresh session, insert one
//   QuantityInput, fire rules, query GeneratedCurrencyPrices, then discard the
//   session.

declare QuantityInput
    quantity: int
end

enum Currency
    CNY
    USD
end

declare DiscountTier
    currency: Currency
    unitPrice: double
    minQuantity: int
    discountRate: double
end

declare SelectedDiscountTier
    currency: Currency
    quantity: int
    unitPrice: double
    minQuantity: int
    discountRate: double
end

declare CurrencyPriceResult
    currency: Currency
    quantity: int
    unitPrice: double
    discountRate: double
    totalBeforeDiscount: double
    totalPrice: double
end

// Discount tiers are configuration facts. Load them from JSON/DataBind or host code
// before firing rules.

rule "select discount tier per currency"
    salience 100
    when
        $input : QuantityInput($quantity : quantity, quantity >= 1)
        $tier : DiscountTier($currency : currency,
                             $unitPrice : unitPrice,
                             $minQuantity : minQuantity,
                             minQuantity <= $quantity,
                             $discountRate : discountRate)
        not DiscountTier(currency == $currency,
                         minQuantity > $minQuantity,
                         minQuantity <= $quantity)
        not SelectedDiscountTier(currency == $currency,
                                 quantity == $quantity)
    then
        insert SelectedDiscountTier {
            currency = $tier.currency,
            quantity = $input.quantity,
            unitPrice = $tier.unitPrice,
            minQuantity = $tier.minQuantity,
            discountRate = $tier.discountRate
        }
end

rule "calculate selected currency price"
    salience 90
    when
        $tier : SelectedDiscountTier($currency : currency,
                                     $quantity : quantity,
                                     $unitPrice : unitPrice,
                                     $discountRate : discountRate)
        not CurrencyPriceResult(currency == $currency,
                                quantity == $quantity)
    then
        insert CurrencyPriceResult {
            currency = $tier.currency,
            quantity = $tier.quantity,
            unitPrice = $tier.unitPrice,
            discountRate = $tier.discountRate,
            totalBeforeDiscount = $tier.quantity * $tier.unitPrice,
            totalPrice = $tier.quantity * $tier.unitPrice * $tier.discountRate
        }
end

query "GeneratedCurrencyPrices"
    $price : CurrencyPriceResult()
end
