package com.example

declare Person
    name: String
    age: int
    city: String
end

declare Pet
    owner: String
    type: String
end

rule "Find young people in London"
when
    $p: Person( age < 30, city == "London" )
then
    -- This code is just stored as a string, not executed.
    println("Found young person: " .. $p.name)
end

rule "Find cat owners"
when
    $person : Person()
    $pet : Pet( type == "Cat", owner == $person.name )
then
    println($person.name .. " owns a cat!")
end
