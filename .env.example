# Merge non-secret fields into .env; preserve existing credentials and compiler settings.
# The parent environment selects exact stable releases. CMake does not read .env.
VCPKG_CACHE_VERSION=0.1.3
VCPKG_CACHE_REPOSITORY_ROOT=C:/projects/cpp/turbonet/vcpkg-cache
SALTS_BASE_VERSION=0.1.8
CMETA_VERSION=0.1.7
SALTS_CORE_VERSION=0.1.12
SALTS_UTILS_VERSION=0.1.4
TOAD_VERSION=0.1.3
LLVM_MINGW_ROOT=C:/tools/llvm-mingw
CMAKE_BUILD_PARALLEL_LEVEL=3
# Optional: reuse already qualified roots from the same release/compiler/triplet.
# VCPKG_INSTALLED_DIR=C:/sdk/vcpkg-cache-0.1.3-qigao-x64-windows-llvm-mingw/payload/vcpkg_installed
# SALTS_BASE_ROOT=C:/sdk/salts-base-0.1.8-windows-llvm-mingw-x64
# CMETA_ROOT=C:/sdk/cmeta-0.1.7-windows-llvm-mingw-x64
# SALTS_CORE_ROOT=C:/sdk/salts-cnet-0.1.12-windows-x64
# SALTS_UTILS_ROOT=C:/sdk/salts-utils-0.1.4-windows-llvm-mingw-x64
# TOAD_ROOT=C:/sdk/toad-0.1.3-windows-llvm-mingw-x64
# RE2C_ROOT=C:/sdk/re2c/payload/tools/windows-x64
# LEMON_ROOT=C:/sdk/lemon/payload/tools/windows-x64
# Existing roots must have matching restore receipts; they are never overwritten.
# Without explicit roots, restore selects versioned destinations under build/dependencies.
# Supply GITHUB_TOKEN in the parent environment (an authenticated gh login can supply it).
