{
    "version": 6,
    "configurePresets": [
        {
            "name": "flags-msvc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_FLAGS": "/utf-8 /D_WIN32 /D_WINDOWS /diagnostics:caret /W4 /wd4996 /wd4324 /wd4245 /wd4100 /wd4200 /wd4267 /wd4244",
                "CMAKE_CXX_FLAGS": "/utf-8 /D_WIN32 /D_WINDOWS /diagnostics:caret /W4 /wd4996 /wd4324 /wd4245 /wd4100 /permissive- /volatile:iso /Zc:inline /Zc:preprocessor /Zc:enumTypes /Zc:lambda /Zc:__cplusplus /Zc:externConstexpr /Zc:throwingNew /EHsc",
                "CMAKE_EXE_LINKER_FLAGS": "/machine:x64 /guard:cf"
            }
        },
        {
            "name": "flags-gcc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-fstack-protector-strong -Wall -Wextra -Wpedantic -Wformat=2 -Wundef -Wshadow -Wcast-align -Wunused -Wnull-dereference",
                "CMAKE_C_FLAGS_DEBUG": "-O0 -g3 -fno-omit-frame-pointer",
                "CMAKE_C_FLAGS_RELEASE": "-O2 -DNDEBUG",
                "CMAKE_CXX_FLAGS": "-D_GLIBCXX_ASSERTIONS=1 -fstack-protector-strong -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wcast-qual -Wformat=2 -Wundef -Wshadow -Wcast-align -Wunused -Wnull-dereference -Wdouble-promotion -Wimplicit-fallthrough -Woverloaded-virtual -Wnon-virtual-dtor -Wold-style-cast -fexceptions",
                "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g3 -fno-omit-frame-pointer",
                "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG",
                "CMAKE_EXE_LINKER_FLAGS": "-Wl,--as-needed,-z,noexecstack,-z,relro,-z,now",
                "CMAKE_SHARED_LINKER_FLAGS": "-Wl,--as-needed,-z,noexecstack,-z,relro,-z,now"
            }
        },
        {
            "name": "flags-clang",
            "description": "Cross-platform Clang/LLVM warning baseline",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-fstack-protector-strong -Wall -Wextra -Wpedantic -Wformat=2 -Wundef -Wshadow -Wcast-align -Wunused -Wnull-dereference",
                "CMAKE_CXX_FLAGS": "-fstack-protector-strong -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wcast-qual -Wformat=2 -Wundef -Werror=float-equal -Wshadow -Wcast-align -Wunused -Wnull-dereference -Wdouble-promotion -Wimplicit-fallthrough -Wextra-semi -Woverloaded-virtual -Wnon-virtual-dtor -Wold-style-cast -fexceptions",
                "CMAKE_EXE_LINKER_FLAGS": "-Wl,--as-needed,-z,noexecstack,-z,relro,-z,now",
                "CMAKE_SHARED_LINKER_FLAGS": "-Wl,--as-needed,-z,noexecstack,-z,relro,-z,now"
            }
        },
        {
            "name": "flags-appleclang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-fstack-protector-strong -Wall -Wextra -Wpedantic -Wformat=2 -Wundef -Wshadow -Wcast-align -Wunused -Wnull-dereference",
                "CMAKE_CXX_FLAGS": "-fstack-protector-strong -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wcast-qual -Wformat=2 -Wundef -Werror=float-equal -Wshadow -Wcast-align -Wunused -Wnull-dereference -Wdouble-promotion -Wimplicit-fallthrough -Wextra-semi -Woverloaded-virtual -Wnon-virtual-dtor -Wold-style-cast -fexceptions"
            }
        },
        {
            "name": "flags-clang-windows",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-fstack-protector-strong -Wall -Wextra -Wpedantic -Wformat=2 -Wundef -Wshadow -Wcast-align -Wunused -Wnull-dereference",
                "CMAKE_CXX_FLAGS": "-fstack-protector-strong -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wcast-qual -Wformat=2 -Wundef -Werror=float-equal -Wshadow -Wcast-align -Wunused -Wnull-dereference -Wdouble-promotion -Wimplicit-fallthrough -Wextra-semi -Woverloaded-virtual -Wnon-virtual-dtor -Wold-style-cast -fexceptions"
            }
        }
    ]
}
