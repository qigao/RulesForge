@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(SaltsBase @SaltsBase_VERSION@ EXACT CONFIG REQUIRED PATHS "$ENV{SALTS_BASE_ROOT}"
                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(CMeta @CMeta_VERSION@ EXACT CONFIG REQUIRED PATHS "$ENV{CMETA_ROOT}"
                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(SaltsUtils @SaltsUtils_VERSION@ EXACT CONFIG REQUIRED PATHS "$ENV{SALTS_UTILS_ROOT}"
                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(Toad @Toad_VERSION@ EXACT CONFIG REQUIRED PATHS "$ENV{TOAD_ROOT}"
                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
include("${CMAKE_CURRENT_LIST_DIR}/RulesForgeTargets.cmake")
check_required_components(RulesForge)
