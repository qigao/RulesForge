{
  "version": 6,
  "include": [
    "CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "vcpkg-cache-ci",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{VCPKG_CACHE_REPOSITORY_ROOT}",
        "VCPKG_BINARY_SOURCES": "$penv{VCPKG_BINARY_SOURCES}"
      }
    },
    {
      "name": "vcpkg-cache-linux",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x64-linux"
      },
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{HOME}/.cache/qigao/vcpkg-cache"
      }
    },
    {
      "name": "vcpkg-cache-windows",
      "hidden": true,
      "inherits": "vcpkg-cache",
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "x64-windows"
      },
      "environment": {
        "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{LOCALAPPDATA}/qigao/vcpkg-cache",
        "RE2C_ROOT": "$env{PKG_ROOT}/re2c/windows-x64"
      }
    },
    {
      "name": "vcpkg-cache",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/cmake/QigaoVcpkgToolchain.cmake",
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;default,readwrite;nugettimeout,1800;nugetconfig,${sourceDir}/cmake/vcpkg-cache.nuget.config,read",
        "VCPKG_OVERLAY_PORTS": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/ports",
        "RE2C_ROOT": "$penv{RE2C_ROOT}",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "win-toolchain",
      "hidden": true,
      "environment": {
        "PROJECT_ROOT": "C:/projects/cpp",
        "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
        "VCPKG_ROOT": "C:/tools/vcpkg",
        "USER_ROOT": "C:/Users/lockg",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      },
      "inherits": [
        "vcpkg-cache-windows"
      ]
    },
    {
      "name": "win-paths",
      "hidden": true,
      "inherits": "win-toolchain",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "ON"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "linux-paths",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_MANIFEST_MODE": "ON"
      },
      "environment": {
        "PKG_ROOT": "/opt",
        "VCPKG_ROOT": "/opt/vcpkg",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      },
      "inherits": [
        "vcpkg-cache-linux"
      ]
    },
    {
      "name": "android-win-environment",
      "hidden": true,
      "inherits": "win-toolchain",
      "environment": {
        "ANDROID_SDK_ROOT": "$env{USER_ROOT}/AppData/Local/Android/Sdk",
        "ANDROID_NDK_VERSION": "28.2.13676358",
        "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
      }
    },
    {
      "name": "android-win-user-paths",
      "hidden": true,
      "inherits": [
        "vcpkg-cache-windows",
        "android-win-paths",
        "ISWindows"
      ],
      "cacheVariables": {
        "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}"
      }
    },
    {
      "name": "win-dev-user",
      "inherits": [
        "base-win-dev-user",
        "win-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/rules_forge/debug"
      }
    },
    {
      "name": "win-release-user",
      "inherits": [
        "base-win-release-user",
        "win-paths"
      ],
      "binaryDir": "${sourceDir}/build/Msvc-Release-rc",
      "environment": {
        "SALTS_ROOT": "${sourceDir}/build/native-sdk-rc/Salts.Native/sdk/windows-x64",
        "SALTS_UTILS_ROOT": "${sourceDir}/build/native-sdk-rc/SaltsUtils.Native/sdk/windows-x64",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc-Release-rc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/rules_forge/release"
      }
    },
    {
      "name": "linux-dev-user",
      "inherits": [
        "base-linux-dev-user",
        "linux-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/rules_forge/debug"
      }
    },
    {
      "name": "linux-release-user",
      "inherits": [
        "release-linux-ninja",
        "linux-paths"
      ],
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
        "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/rules_forge/release"
      }
    },
    {
      "name": "linux-sdk-package",
      "inherits": [
        "linux-release-user"
      ],
      "binaryDir": "${sourceDir}/build/linux-gcc-sdk-package",
      "cacheVariables": {
        "ENABLE_SANITIZER_ADDRESS": "OFF",
        "ENABLE_TESTS": "OFF",
        "BUILD_TESTS": "OFF",
        "BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "android-dependencies-debug",
      "hidden": true,
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/debug",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/debug"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/rules_forge-android/debug"
      }
    },
    {
      "name": "android-dependencies-release",
      "hidden": true,
      "environment": {
        "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/release",
        "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/release"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/rules_forge-android/release"
      }
    },
    {
      "name": "android-arm64-v8a-debug-win",
      "inherits": [
        "android-arm64-v8a-debug",
        "android-dependencies-debug",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-arm64-v8a-release-win",
      "inherits": [
        "android-arm64-v8a-release",
        "android-dependencies-release",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86_64-debug-win",
      "inherits": [
        "android-x86_64-debug",
        "android-dependencies-debug",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86_64-release-win",
      "inherits": [
        "android-x86_64-release",
        "android-dependencies-release",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86-debug-win",
      "inherits": [
        "android-x86-debug",
        "android-dependencies-debug",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "android-x86-release-win",
      "inherits": [
        "android-x86-release",
        "android-dependencies-release",
        "android-win-user-paths",
        "android-win-environment"
      ]
    },
    {
      "name": "ci-release-base",
      "hidden": true,
      "inherits": [
        "vcpkg-cache-ci",
        "pkg-vcpkg"
      ],
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "SALTS_ROOT": "$penv{SALTS_ROOT}",
        "SALTS_UTILS_ROOT": "$penv{SALTS_UTILS_ROOT}",
        "VCPKG_ROOT": "$penv{VCPKG_ROOT}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "ENABLE_TESTS": "ON",
        "ENABLE_SAMPLES": "ON",
        "ENABLE_BENCHMARKS": "OFF",
        "ENABLE_SANITIZER_ADDRESS": "OFF",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "$env{CI_VCPKG_TRIPLET}",
        "VCPKG_HOST_TRIPLET": "$env{CI_VCPKG_TRIPLET}",
        "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/$env{CI_VCPKG_TRIPLET}",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/stage/${presetName}"
      }
    },
    {
      "name": "ci-linux-x64",
      "inherits": [
        "ci-release-base",
        "ISLinux",
        "Gcc",
        "flags-gnu"
      ],
      "environment": {
        "CI_VCPKG_TRIPLET": "x64-linux",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/${presetName}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{CI_VCPKG_TRIPLET}/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/${presetName}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{CI_VCPKG_TRIPLET}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "ci-linux-arm64",
      "inherits": [
        "ci-release-base",
        "ISLinux",
        "Gcc",
        "flags-gnu-arm64"
      ],
      "environment": {
        "CI_VCPKG_TRIPLET": "arm64-linux",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/${presetName}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{CI_VCPKG_TRIPLET}/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/${presetName}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{CI_VCPKG_TRIPLET}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
      }
    },
    {
      "name": "ci-windows-x64",
      "inherits": [
        "ci-release-base",
        "ISWindows",
        "Msvc",
        "flags-msvc"
      ],
      "environment": {
        "CI_VCPKG_TRIPLET": "qigao-x64-windows-v145",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/${presetName}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{CI_VCPKG_TRIPLET}/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$penv{PATH}"
      }
    },
    {
      "name": "ci-macos-arm64",
      "inherits": [
        "ci-release-base",
        "ISMac",
        "AppleClang",
        "flags-darwin"
      ],
      "environment": {
        "CI_VCPKG_TRIPLET": "arm64-osx",
        "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/${presetName}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{CI_VCPKG_TRIPLET}/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$penv{PATH}",
        "LD_LIBRARY_PATH": "${sourceDir}/build/${presetName}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{CI_VCPKG_TRIPLET}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}",
        "DYLD_LIBRARY_PATH": "${sourceDir}/build/${presetName}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{CI_VCPKG_TRIPLET}/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$penv{DYLD_LIBRARY_PATH}"
      }
    }
  ],
