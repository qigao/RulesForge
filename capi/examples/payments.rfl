package com.example.pricing

declare Order
    quantity: int
    unitPrice: double
    finalPrice: double
end

// Rule 1: No discount (1-2 items)
rule "No Discount"
    no-loop
    when
        $order : Order( quantity >= 1, quantity <= 2, finalPrice <= 0.01 )
    then
        console.log("No Discount fired: qty=" + $order.quantity);
        var subtotal = $order.quantity * $order.unitPrice;
        rfl.update($order, {finalPrice: subtotal});
end

// Rule 2: 5% discount (3-5 items)
rule "Medium Discount"
    no-loop
    when
        $order : Order( quantity >= 3, quantity <= 5, finalPrice <= 0.01 )
    then
        console.log("Medium Discount fired: qty=" + $order.quantity);
        var subtotal = $order.quantity * $order.unitPrice * 0.95;
        rfl.update($order, {finalPrice: subtotal});
end

// Rule 3: 10% discount (6+ items)
rule "High Discount"
    no-loop
    when
        $order : Order( quantity >= 6, finalPrice <= 0.01 )
    then
        console.log("High Discount fired: qty=" + $order.quantity);
        var subtotal = $order.quantity * $order.unitPrice * 0.90;
        rfl.update($order, {finalPrice: subtotal});
end

// Rule 4: Round down final price if quantity > 2
rule "Round Down Payment"
    salience -10
    no-loop
    when
        $order : Order( quantity > 2, finalPrice > 0.01 )
    then
        console.log("Round Down fired: qty=" + $order.quantity + ", finalPrice=" + $order.finalPrice);
        var rounded = Math.floor($order.finalPrice);
        rfl.update($order, {finalPrice: rounded});
end

query "OrdersWithDiscount"
    $order : Order( finalPrice > 0.01 )
end
