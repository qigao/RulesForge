@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(DEFINED ENV{SALTS_ROOT})
    find_dependency(Salts CONFIG PATHS "$ENV{SALTS_ROOT}" NO_DEFAULT_PATH)
else()
    find_dependency(Salts CONFIG)
endif()
if(DEFINED ENV{SALTS_UTILS_ROOT})
    find_dependency(SaltsUtils CONFIG PATHS "$ENV{SALTS_UTILS_ROOT}" NO_DEFAULT_PATH)
else()
    find_dependency(SaltsUtils CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/RulesForgeTargets.cmake")

check_required_components(RulesForge)

# Provide convenient alias
if(NOT TARGET RulesForge::RulesForge)
    add_library(RulesForge::RulesForge ALIAS RulesForge::rules_forge)
endif()
