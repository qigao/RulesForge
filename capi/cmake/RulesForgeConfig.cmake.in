@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT DEFINED ENV{SALTS_ROOT} OR "$ENV{SALTS_ROOT}" STREQUAL "")
    set(RulesForge_FOUND FALSE)
    set(RulesForge_NOT_FOUND_MESSAGE
        "SALTS_ROOT must name the installed Salts profile")
    return()
endif()
if(NOT DEFINED ENV{SALTS_UTILS_ROOT} OR "$ENV{SALTS_UTILS_ROOT}" STREQUAL "")
    set(RulesForge_FOUND FALSE)
    set(RulesForge_NOT_FOUND_MESSAGE
        "SALTS_UTILS_ROOT must name the installed SaltsUtils profile")
    return()
endif()

find_dependency(Salts 1.8.3 EXACT CONFIG REQUIRED
    PATHS "$ENV{SALTS_ROOT}" NO_DEFAULT_PATH)
find_dependency(SaltsUtils 4.1.3 EXACT CONFIG REQUIRED
    PATHS "$ENV{SALTS_UTILS_ROOT}" NO_DEFAULT_PATH)

file(REAL_PATH "$ENV{SALTS_UTILS_ROOT}" _RulesForge_SaltsUtils_real_root)
if(NOT DEFINED SaltsUtils_DIR OR SaltsUtils_DIR STREQUAL "")
    set(RulesForge_FOUND FALSE)
    set(RulesForge_NOT_FOUND_MESSAGE
        "SaltsUtils package root cannot be verified")
    return()
endif()
file(REAL_PATH "${SaltsUtils_DIR}" _RulesForge_SaltsUtils_real_dir)
cmake_path(IS_PREFIX _RulesForge_SaltsUtils_real_root
           "${_RulesForge_SaltsUtils_real_dir}" NORMALIZE
           _RulesForge_SaltsUtils_is_within_root)
if(NOT _RulesForge_SaltsUtils_is_within_root)
    set(RulesForge_FOUND FALSE)
    set(RulesForge_NOT_FOUND_MESSAGE
        "SaltsUtils_DIR is outside SALTS_UTILS_ROOT: ${SaltsUtils_DIR}")
    return()
endif()

if(NOT TARGET Salts::DataBind)
    set(RulesForge_FOUND FALSE)
    set(RulesForge_NOT_FOUND_MESSAGE
        "SaltsUtils 4.1.3 package is missing required target Salts::DataBind")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/RulesForgeTargets.cmake")

check_required_components(RulesForge)
