package com.example.pricing

declare Order
    quantity: int
    unitPrice: double
    finalPrice: double
end

declare RouteDecision
    target: string
    payload: string
    metadata: string
end

// Pricing rules
rule "No Discount"
    no-loop
    when
        $order : Order( quantity >= 1, quantity <= 2, finalPrice <= 0.01 )
    then
        update $order { finalPrice = $order.quantity * $order.unitPrice }
end

rule "Medium Discount"
    no-loop
    when
        $order : Order( quantity >= 3, quantity <= 5, finalPrice <= 0.01 )
    then
        update $order { finalPrice = $order.quantity * $order.unitPrice * 0.95 }
end

rule "High Discount"
    no-loop
    when
        $order : Order( quantity >= 6, finalPrice <= 0.01 )
    then
        update $order { finalPrice = $order.quantity * $order.unitPrice * 0.90 }
end

rule "Round Down Payment"
    salience -10
    no-loop
    when
        $order : Order( quantity > 2, finalPrice > 0.01 )
    then
        update $order { finalPrice = floor($order.finalPrice) }
end

// Routing rules
rule "Route High Value Order"
    salience -20
    when
        $order : Order( finalPrice >= 100.0 )
    then
        insert RouteDecision {
            target = "high_value_sink",
            payload = "dispatch:high_value",
            metadata = "high_value"
        }
end

rule "Route Default Order"
    salience -20
    when
        $order : Order( finalPrice > 0.01, finalPrice < 100.0 )
    then
        insert RouteDecision {
            target = "default_sink",
            payload = "",
            metadata = "default"
        }
end

query "get_route_decisions"
    $decision : RouteDecision()
end
